# Nix / direnv
.direnv/
result
result-*

# Python bytecode. The gate scripts are extensionless python programs, so a
# run that imports one writes a __pycache__ beside them.
__pycache__/
*.py[cod]

# ruff's own cache. It writes a self-ignoring .gitignore inside the directory
# it creates, which is why it does not show up as untracked debris under a
# plain `git status` — declared here anyway so the repo's own ignore rules
# do not depend on that generated file being present.
.ruff_cache/

# Rendered output of the gallery render, and the schema's projected library a
# local `render-project` run against fixtures/ writes beside it — both
# regenerated on demand, never committed.
fixtures/*.pdf
fixtures/.render/

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/
