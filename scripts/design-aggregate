#!/usr/bin/env python3
"""design-aggregate — compile the whole design layer into ONE navigable PDF.

The per-context `design.md` files stay the unit of authoring, review, and
ownership. That is a claim about the SOURCE, and it is the reason the layer is
N files: making the source one file would make every write a write to the same
artifact, so two agents could not reconcile two contexts at once.

It does not transfer to the OUTPUT, which nobody hand-writes. So the sources
stay separate and the render unifies: this script compiles them into one
document with a table of contents, the contexts as chapters, and every glossary
gathered into one alphabetised section.

THIS IS THE LAYER'S RENDERED DOCUMENT, not one artifact among several. A
context's design.md renders into it as a chapter and emits no sibling PDF of
its own. A host that keeps a standalone reference document outside the
aggregate — a vocabulary gallery it wants adopters to browse on its own,
say — renders that one document separately with design-render instead of
folding it in here; this repo's own fixtures/widget-gallery.md is exactly
that shape; see its "How this file is rendered" section.

Inside one document a citation of a CONTEXT term is an INTRA-document reference,
so the compiler resolves it and a missing term fails the build with a source
location. That is a convenience, NOT the layer's vocabulary check — a claim to
the contrary was tested and withdrawn: layer-integrity already reports a
dangling term anchor by file and reason, across separate files, which is where
that check belongs.

Usage:
  design-aggregate <layer-root> <out.pdf>            build the document
  design-aggregate <layer-root> <out.pdf> --check    regenerate and compare

  <layer-root> is the directory holding the root design.md and the per-context
  subdirectories (conventionally docs/design).

Exit: 0 clean, 1 the aggregate failed to compile or is stale, 2 error.
"""

import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))

# the router owns the markdown->typst inline conversion; the aggregate reuses
# it rather than keeping a second copy that could drift.
_spec = importlib.util.spec_from_loader(
    "md_to_typst",
    importlib.machinery.SourceFileLoader("md_to_typst",
                                         os.path.join(HERE, "md-to-typst")))
_router = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_router)
inline = _router.inline
prose = _router.prose

# the renderer-warning rule has ONE home, in the gate; the aggregate composes it
# rather than keeping a second copy that could drift.
_gspec = importlib.util.spec_from_loader(
    "design_render",
    importlib.machinery.SourceFileLoader("design_render",
                                         os.path.join(HERE, "design-render")))
_gate = importlib.util.module_from_spec(_gspec)
_gspec.loader.exec_module(_gate)
warns = _gate.warns

def _term_re_from_schema():
    """Derive the glossary term heading pattern from the ONE declared schema,
    never a hardcoded copy.

    A hardcoded `^###` here once disagreed with layer-integrity, which reads
    the schema's anchors.term.heading_regex directly and — before that regex
    was tightened to match anchors.term.heading_form — accepted a term anchor
    at ANY heading level. A layer authored at the level layer-integrity
    accepted passed that gate clean while this aggregate silently counted
    zero terms and rendered an empty glossary: two readers of one declared
    vocabulary, disagreeing, with no error either side. Deriving the level
    from heading_form here closes that gap structurally — a future schema
    edit to the term heading's level re-derives this pattern instead of
    leaving a second copy to fall out of step.
    """
    schema = _gate.load_schema()
    form = schema["anchors"]["term"]["heading_form"]
    m = re.match(r"^(#+)\s", form)
    if not m:
        sys.stderr.write(
            "design-aggregate: error: anchors.term.heading_form %r does not "
            "open with a markdown heading prefix\n" % form)
        sys.exit(2)
    prefix = re.escape(m.group(1))
    return re.compile(
        r"^%s\s+(?P<title>.+?)\s*\{#(?P<slug>term-[a-z0-9]+(?:-[a-z0-9]+)*)\}\s*$"
        % prefix)


TERM_RE = _term_re_from_schema()
H1_RE = re.compile(r"^#\s+(.*)$")

# ---------------------------------------------------------------------------
# internal links — a relative path is a FILE reference, and this is one document
# ---------------------------------------------------------------------------
# The layer's links are authored as relative markdown paths, which is correct on
# the source side: `CONTEXT.md#term-pending-ledger` resolves in a diff, on a
# forge, and in an editor. Inside ONE rendered document those paths have no
# meaning — a PDF viewer treats them as external URIs and offers to open another
# application, so every cross-reference in the layer's 200+ term citations dead-
# ends. The aggregate therefore rewrites a destination that HAS an internal
# target into a Typst label reference, and leaves the rest alone.
#
# Four destination shapes carry an internal target:
#   CONTEXT.md#term-x          a glossary term      -> <term-x>
#   ../<ctx>/CONTEXT.md#term-x another context's    -> <term-x>   (one glossary)
#   <ctx>/design.md            a chapter            -> <ctx-...>
#   design.md#NN-heading       a section            -> <sec-...>
# An ADR link stays external: the ADRs are not part of this document, so there is
# nothing to jump to and a live external link is the honest result.
# The SOURCE-side rewrite. A prose link stays ordinary markdown all the way to
# cmarker, so its destination is resolved HERE, in the authored text, before any
# conversion runs: `[t](CONTEXT.md#term-x)` becomes `[t](@term-x)`. A `@`-prefixed
# destination is still a plain markdown link, so cmarker pairs surrounding
# emphasis normally — which injecting a Typst call into the text does not, because
# a raw-typst span makes cmarker escape every `**` after it.
# The projected library's `show link:` rule turns an `@name` destination into a
# real label reference at render time.
MD_LINK_RE = re.compile(r"\[([^\]]+)\]\(([^)]+)\)")


def rewrite_md_links(md, stem, known_labels):
    """Rewrite authored markdown destinations to @label where one exists."""
    def sub(m):
        label = resolve_dest(m.group(2), stem, known_labels)
        if label is None:
            return m.group(0)
        return "[%s](@%s)" % (m.group(1), label)
    return MD_LINK_RE.sub(sub, md)


def resolve_dest(dest, stem, known_labels):
    """Map an authored relative destination to an internal label, or None."""
    anchor = None
    if "#" in dest:
        path, anchor = dest.split("#", 1)
    else:
        path = dest
    # a term or ADR anchor names its target directly, wherever it was cited from
    if anchor and anchor.startswith("term-"):
        return anchor if anchor in known_labels else None
    if anchor and anchor.startswith("adr-"):
        return None            # ADRs are not in this document
    # a bare in-page anchor: `#00-foundation` names a section of the CITING
    # chapter, so it resolves against that chapter's own scoped labels.
    if not path and anchor:
        cand = "sec-%s-%s" % (stem, anchor.lstrip("#"))
        return cand if cand in known_labels else None
    # a design.md path names a chapter; with an anchor it names a section there,
    # and the section belongs to the chapter the PATH points at, not the citer.
    base = os.path.basename(path)
    if base == "design.md":
        d = os.path.dirname(path.rstrip("/"))
        parent = os.path.basename(d)
        if parent not in ("", ".", ".."):
            target_stem = parent          # `../lifecycle/design.md`
        elif d in ("..", "../"):
            target_stem = "root"          # `../design.md` — up out of a context
        elif d == "":
            # a bare `design.md`, cited from inside a context's own folder
            # (a CONTEXT.md pointing at its sibling document): the target is the
            # CITING context, not the root.
            target_stem = stem
        else:
            target_stem = "root"
        if anchor:
            cand = "sec-%s-%s" % (target_stem, anchor)
            return cand if cand in known_labels else None
        target = "ctx-" + target_stem
        return target if target in known_labels else None
    return None


def read_frontmatter(path):
    fm = {}
    text = open(path, encoding="utf-8").read()
    if text.startswith("---\n"):
        end = text.index("\n---\n", 3)
        for line in text[4:end].split("\n"):
            if ":" in line:
                k, v = line.split(":", 1)
                fm[k.strip()] = v.strip()
    return fm


class MixedLayer(Exception):
    """A layer holding both markdown and Typst sources."""


def compile_and_verify(agg, root, out_pdf, check, lib, cleanup,
                       n_contexts, n_terms):
    """Render the assembled document, then build-or-verify it.

    Shared by both authoring modes: the assembly differs, the compile and the
    freshness contract do not, so there is one implementation of the part that
    decides pass or fail.
    """
    typst = os.environ.get("TYPST", "typst")
    # Under --check the fresh render goes to a temp file and the committed
    # document is left alone, so a stale artifact is REPORTED rather than
    # silently repaired.
    tmpdir = tempfile.mkdtemp(prefix="design-aggregate.") if check else None
    target = os.path.join(tmpdir, "fresh.pdf") if check else os.path.abspath(out_pdf)
    # A PDF embeds a creation timestamp, so two renders of one source would
    # differ in bytes for no reason a reader can see. Pinning the timestamp is
    # what makes the freshness check a plain byte-compare. This render happened
    # to be reproducible without the pin — Typst omits the field here — but that
    # is undocumented behavior, and a gate resting on it is resting on an
    # accident, the same shape as a read-only package cache standing in for an
    # offline contract.
    env = dict(os.environ, SOURCE_DATE_EPOCH="0")
    try:
        proc = subprocess.run(
            [typst, "compile", agg, target,
             # the renderer refuses any source outside its project root, and
             # the library may sit outside the layer under $DESIGN_LIB_DIR, so
             # the root must span both the layer and the library.
             "--root", os.path.commonpath(
                 [os.path.abspath(os.path.join(root, "..", "..")),
                  os.path.abspath(lib)])],
            capture_output=True, text=True, env=env)
    finally:
        for f in cleanup:
            if os.path.exists(f):
                os.remove(f)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        return 1
    if warns(proc.stderr, out_pdf, report=sys.stderr.write):
        return 1

    if check:
        if not os.path.exists(out_pdf):
            sys.stderr.write("design-aggregate: %s is missing (the layer has "
                             "no rendered document)\n" % out_pdf)
            return 1
        with open(out_pdf, "rb") as f:
            committed = f.read()
        with open(target, "rb") as f:
            fresh = f.read()
        if committed != fresh:
            sys.stderr.write("design-aggregate: %s is stale (does not match a "
                             "fresh render)\n" % out_pdf)
            return 1
        sys.stdout.write("design-aggregate: %s is fresh (%d context(s), %d "
                         "term(s))\n" % (out_pdf, n_contexts, n_terms))
        return 0

    sys.stdout.write("design-aggregate: wrote %s (%d context(s), %d term(s))\n"
                     % (out_pdf, n_contexts, n_terms))
    return 0


def aggregate_typst(root, out_pdf, check, lib, docs):
    """Assemble a TYPST-authored layer into the one rendered document.

    There is no conversion step here, which is the point of the mode: each
    context's design.typ is imported as a Typst module and its `body` is
    placed under the chapter heading. Nothing parses the authored file, so no
    construct can be half-translated.

    The per-document page shell is NOT applied — the aggregate supplies one
    shell for the whole layer, exactly as it does on the markdown side. A
    context's design.typ therefore exports its content as `body` rather than
    calling `design-doc` itself.

    WHERE THE DOCUMENT-LEVEL CONTRACTS GO, stated plainly because the answer
    differs by mode. On the markdown side `assert_document` re-parses the
    authored file to check foundation order, spine order, and pending-entry
    validity — contracts no per-block function can see, since a function only
    runs when it is called and cannot notice a block nobody wrote. That parser
    reads markdown, so it does not run here, and running it against Typst
    source would report nothing while looking like a check.

    In this mode those contracts belong to the library, which can hold them
    because the author calls it directly: a `section` cannot omit its title, a
    `pending-entry` cannot carry a malformed date, and an ordering rule is a
    call-order the document itself expresses.

    The foundation ORDER is enforced that way here. Each foundation statement
    records its kind in a state as it is called, and `assert-foundation-order`
    reads the trail back. The scope is ONE CONTEXT — the trail is cleared before
    each chapter's body and judged at the end of it — because a layer renders
    many chapters into one document, and a chapter opening on a goal does not
    follow the previous chapter's principle.
    """
    gen_dir = os.path.join(root, ".render")
    os.makedirs(gen_dir, exist_ok=True)
    rel_lib = os.path.relpath(os.path.abspath(lib), os.path.abspath(gen_dir))
    cleanup = []

    L = ['#import "%s": *' % rel_lib, ""]
    L.append("#show: aggregate-doc.with(")
    L.append('  title: [Design layer],')
    L.append('  subtitle: [the whole layer, as one document],')
    L.append(")")
    L.append("")

    for name, doc in docs:
        stem = "root" if name is None else name
        rel_doc = os.path.relpath(os.path.abspath(doc),
                                  os.path.abspath(gen_dir))
        mod = "_ctx_%s" % re.sub(r"[^A-Za-z0-9]", "_", stem)
        L.append('#import %s as %s' % (_typ_str(rel_doc), mod))
        # The chapter heading carries the context label, so a cross-document
        # reference resolves to it. A document declaring its own `title` names
        # the chapter; otherwise the directory name does. A Typst module is not
        # a dictionary, so the presence test goes through dictionary(), which
        # is the conversion that lets a missing binding fall back rather than
        # fail the build.
        L.append('#let _m = dictionary(%s)' % mod)
        L.append('#let _t = if "title" in _m { _m.title } else { %s }'
                 % _typ_str(stem + " context"))
        L.append("#chapter-page(_t, kind: %s)"
                 % _typ_str("root design" if stem == "root" else "context"))
        L.append("#pagebreak()")
        L.append("= #_t <ctx-%s>" % stem)
        # The foundation ORDER is judged per context, so the trail is cleared
        # before each chapter's body. Without the reset a later chapter opening
        # on a goal would read as following the previous chapter's principle.
        L.append("#foundation-scope-reset")
        L.append("#%s.body" % mod)
        # ...and judged at the end of that body, while the trail still holds
        # this context's calls and no other's.
        L.append("#assert-foundation-order")
        L.append("")

    terms = typst_glossary_terms(root, gen_dir, docs)
    if terms:
        # One import per CONTEXT.typ that declares terms — the glossary reads
        # its titles and bodies out of these modules rather than out of their
        # source text.
        for imp, mod in sorted({(t["import"], t["module"]) for t in terms}):
            L.append('#import %s as %s' % (_typ_str(imp), mod))
        # Find a term by its slug. The panic is the load-bearing half: it is
        # what turns a disagreement between the scrape and the module into a
        # failed build instead of a glossary that renders the wrong definition
        # under a term's name.
        L.append('#let _term-by-slug(ts, slug) = {')
        L.append('  let hit = ts.filter(t => t.slug == slug)')
        L.append('  if hit.len() != 1 {')
        L.append('    panic("glossary: term " + slug + " is not declared '
                 'exactly once in its CONTEXT.typ")')
        L.append('  }')
        L.append('  hit.first()')
        L.append('}')
        L.append("")
        L.append("= Glossary <glossary>")
        L.append("Every term the layer declares, with the context that owns it.")
        L.append("")
        # A term's title and body are placed by REFERENCE into the imported
        # module, never as source text copied out of CONTEXT.typ. The scrape
        # that finds the terms reads raw source, so a `title: [Accent]` is
        # captured as the seven characters `[Accent]` — brackets included,
        # because they are part of the text the file holds. Re-wrapping that in
        # a content block produced `#heading(...)[[Accent]]`, and Typst renders
        # the inner brackets literally: every term in every Typst-authored
        # layer headed itself `[Accent]` and closed its body with a stray `]`.
        #
        # Stripping the captured brackets would fix the common case and break
        # the general one — a title carrying its own markup (`[The #emph[real]
        # name]`) does not survive a text-level unwrap, and neither does a body
        # holding any nested block. Indexing the module hands Typst the AUTHORED
        # VALUE, whatever its shape, so no title or body is parsed twice.
        for t in sorted(terms, key=lambda x: x["sort_key"]):
            # The term is addressed BY SLUG, not by its position in the array.
            # A position would have to survive the scrape agreeing with the
            # module about how many terms there are, and it does not: the
            # pattern cannot match a title holding nested brackets
            # (`title: [The #emph[X] name]`), so such a term is skipped and
            # every later term's index slides by one — which would attach one
            # term's anchor to another term's definition. A slug lookup is
            # order-independent, and `glossary-term` panics when the slug is
            # absent, so a scrape that drifts from the module fails loudly.
            ref = "%s(%s.terms, %s)" % ("_term-by-slug", t["module"],
                                        _typ_str(t["slug"]))
            L.append('#heading(level: 2, outlined: false)[#%s.title] <%s>'
                     % (ref, t["slug"]))
            L.append("#context-owner(%s)" % _typ_str(t["context"]))
            L.append("#%s.body" % ref)
            L.append("")

    agg = os.path.join(gen_dir, "_aggregate.typ")
    open(agg, "w", encoding="utf-8").write("\n".join(L) + "\n")
    cleanup.append(agg)
    return compile_and_verify(agg, root, out_pdf, check, lib, cleanup,
                              len(docs), len(terms))


def typst_glossary_terms(root, gen_dir, docs):
    """Every term a TYPST layer declares, with its owning context.

    A CONTEXT.typ exports `terms`, an array of (slug, title, body) — the same
    three facts the markdown glossary carries as a heading, an anchor, and the
    prose under it.

    WHAT THE SCRAPE IS FOR, and what it is NOT for. Reading the source tells
    the aggregate three things it must know in Python: which terms exist, what
    anchor each declares, and the order they sort in. It does not supply the
    rendered title or body — those are placed by looking the slug up in the
    imported module, so the AUTHORED VALUE reaches the page rather than a
    second parse of the text that produced it.

    The title is read as text for ONE purpose, the sort key, and a title
    carrying markup sorts by the characters it is written with; nothing on the
    rendered page depends on that reading.

    THE BRACKET SCAN IS NOT DECORATION. A title or body is a Typst content
    block, and content blocks NEST — `title: [The #emph[X] name]` is ordinary
    authoring. A regex bounded by the first `]` stops inside such a title,
    fails to match the term, and silently omits it: the glossary loses an entry
    and the summary line reports the smaller count as though it were right.
    Matching brackets by depth is what makes the scan see every term an author
    actually wrote.
    """
    found = []
    for name, doc in docs:
        stem = "root" if name is None else name
        ctx = os.path.join(os.path.dirname(doc), "CONTEXT.typ")
        if not os.path.exists(ctx):
            continue
        src = open(ctx, encoding="utf-8").read()
        rel_ctx = os.path.relpath(os.path.abspath(ctx), os.path.abspath(gen_dir))
        module = "_gl_%s" % re.sub(r"[^A-Za-z0-9]", "_", stem)
        for m in re.finditer(
                r'slug:\s*"(?P<slug>term-[a-z0-9-]+)"\s*,\s*title:\s*', src):
            title = _typst_value_at(src, m.end())
            if title is None:
                continue
            found.append({
                "slug": m.group("slug"),
                "sort_key": title.lower(),
                "context": stem,
                "module": module,
                "import": rel_ctx,
            })
    return found


def _typst_value_at(src, i):
    """The text of the Typst value starting at `i`, or None.

    Handles the two forms a term title takes — a content block `[...]`, read
    with BALANCED brackets so a nested block does not end it early, and a
    quoted string `"..."`. The brackets or quotes themselves are stripped: the
    caller wants the text a reader sees, for sorting.
    """
    if i >= len(src):
        return None
    if src[i] == '"':
        j = src.index('"', i + 1) if '"' in src[i + 1:] else -1
        return src[i + 1:j] if j > i else None
    if src[i] != "[":
        return None
    depth, j = 0, i
    while j < len(src):
        if src[j] == "[":
            depth += 1
        elif src[j] == "]":
            depth -= 1
            if depth == 0:
                return src[i + 1:j]
        j += 1
    return None


def _homes(root):
    """Every place a design document may live, in a stable order.

    (context-name-or-None, directory). The root document first, then each
    context directory alphabetically — the order the chapters render in.
    """
    homes = [(None, root)]
    for name in sorted(os.listdir(root)):
        d = os.path.join(root, name)
        if name.startswith(".") or not os.path.isdir(d):
            continue
        homes.append((name, d))
    return homes


def contexts_of(root):
    """The layer's documents and the MODE they are authored in.

    Returns (mode, [(context-name-or-None, path), ...]) where mode is
    "markdown" or "typst".

    THE MODE IS DERIVED FROM THE FILES, never from a flag, so the declaration
    cannot disagree with the tree (schema design_doc.source_mode). A layer
    authors design.md throughout, or design.typ throughout.

    A MIXED LAYER IS A HARD ERROR, and this is the load-bearing part. Picking
    a winner — preferring one extension, or rendering whichever set is larger
    — produces a document silently missing every context the chosen mode did
    not cover. That reads as a complete layer: the table of contents is
    coherent, every chapter present renders correctly, and nothing marks the
    absence. A half-migrated layer is exactly the state this arises in, so the
    failure must name both sides and stop.
    """
    md, typ = [], []
    for name, d in _homes(root):
        m = os.path.join(d, "design.md")
        t = os.path.join(d, "design.typ")
        if os.path.exists(m):
            md.append((name, m))
        if os.path.exists(t):
            typ.append((name, t))

    if md and typ:
        lines = ["design-aggregate: error: the layer is authored in BOTH "
                 "markdown and Typst, and no rendering of it would be honest.\n"]
        lines.append("  markdown (design.md):\n")
        for _n, p in md:
            lines.append("    %s\n" % os.path.relpath(p, root))
        lines.append("  typst (design.typ):\n")
        for _n, p in typ:
            lines.append("    %s\n" % os.path.relpath(p, root))
        lines.append("  A layer is authored in exactly one mode. Finish the "
                     "migration or revert it; rendering one side would emit a "
                     "document silently missing the other.\n")
        raise MixedLayer("".join(lines))

    if typ:
        return "typst", typ
    return "markdown", md



def glossary_terms(root):
    """Every term the layer declares, with its owning context.

    Both glossary homes are read. A multi-context layer puts each glossary at
    <root>/<context>/CONTEXT.md; a SINGLE-context layer puts its one glossary
    at <root>/CONTEXT.md, which the schema declares in
    layer_layout.single_context.files. Walking only the subdirectories dropped
    that one silently — the smallest layer, which is the shape a first adopter
    creates, rendered with no glossary at all and exit 0.
    """
    homes = []
    root_ctx = os.path.join(root, "CONTEXT.md")
    if os.path.exists(root_ctx):
        homes.append((os.path.basename(os.path.dirname(os.path.abspath(root)))
                      or "design", root_ctx))
    for name in sorted(os.listdir(root)):
        ctx = os.path.join(root, name, "CONTEXT.md")
        if name.startswith(".") or not os.path.exists(ctx):
            continue
        homes.append((name, ctx))

    terms = []
    for name, ctx in homes:
        body, cur = [], None
        for line in open(ctx, encoding="utf-8").read().split("\n"):
            m = TERM_RE.match(line)
            if m:
                cur = {"title": m.group("title"), "slug": m.group("slug"),
                       "context": name, "body": []}
                terms.append(cur)
                continue
            if cur is not None:
                if line.startswith("#"):
                    cur = None
                else:
                    cur["body"].append(line)
    return terms


def main():
    args = [a for a in sys.argv[1:] if a != "--check"]
    check = "--check" in sys.argv[1:]
    if len(args) != 2:
        sys.stderr.write("usage: design-aggregate <layer-root> <out.pdf> [--check]\n")
        return 2
    root, out_pdf = args
    if not os.path.isdir(root):
        sys.stderr.write("design-aggregate: error: no layer root at %s\n" % root)
        return 2

    # $DESIGN_LIB_DIR wins so the projected library can live outside the layer
    # — in a read-only bundle, say — with the layer-root copy as the fallback.
    lib_dir = os.environ.get("DESIGN_LIB_DIR") or os.path.join(root, ".render")
    lib = os.path.join(lib_dir, "designlib.typ")
    if not os.path.exists(lib):
        sys.stderr.write("design-aggregate: error: no projected library at %s "
                         "(run render-project, or set DESIGN_LIB_DIR)\n" % lib)
        return 2

    try:
        mode, docs = contexts_of(root)
    except MixedLayer as exc:
        sys.stderr.write(str(exc))
        return 2
    if not docs:
        sys.stderr.write("design-aggregate: error: no design.md or design.typ "
                         "under %s\n" % root)
        return 2

    if mode == "typst":
        return aggregate_typst(root, out_pdf, check, lib, docs)

    # The scratch directory for the generated Typst stays under the LAYER ROOT,
    # never beside the library: $DESIGN_LIB_DIR may point at a read-only store,
    # and the renderer refuses a source file outside its project root anyway.
    gen_dir = os.path.join(root, ".render")
    os.makedirs(gen_dir, exist_ok=True)
    # the library is imported by a path RELATIVE to the generated .typ, which
    # sits in gen_dir: an absolute path is resolved against the renderer's
    # project root, not the filesystem, so it would not be found.
    rel_lib = os.path.relpath(os.path.abspath(lib), os.path.abspath(gen_dir))
    parts, cleanup = [], []

    # The label set is computed from the AUTHORED sources, before any
    # conversion, because the link rewrite now happens on the markdown itself.
    # Sections are labelled `sec-<stem>-<slug>`, matching the scoping applied to
    # the generated Typst below — every context carries a "00 Foundation", so an
    # unscoped label would be defined five times and Typst rejects a duplicate.
    # The DOCUMENT-LEVEL contracts — foundation cardinality and order, spine
    # ordering, pending-entry validity — are asserted per chapter, here, before
    # anything is rendered. The projected library cannot see them: it validates
    # one block at a time and cannot know a principle preceded an invariant, or
    # that a build entry cites no ADR. design-render carries the fold; the
    # aggregate used to import it only for `warns`, so a layer gated solely
    # through the aggregate — which is what a host's `check` runs — was never
    # asked these questions at all, and an out-of-order foundation rendered
    # clean. Fail closed: report every violation, emit nothing.
    _schema = _gate.load_schema()
    _violations = []
    for _name, _doc in docs:
        _gate.assert_document(_doc, _schema, _violations.append)
    if _violations:
        for v in _violations:
            sys.stderr.write("design-aggregate: violation: %s\n" % v)
        return 1

    known = {"ctx-" + ("root" if n is None else n) for n, _d in docs}
    known |= {t["slug"] for t in glossary_terms(root)}
    for name, doc in docs:
        stem = "root" if name is None else name
        for m in re.finditer(r"^#{1,6}\s+(.*)$",
                             open(doc, encoding="utf-8").read(), re.M):
            known.add("sec-%s-%s" % (stem, _router.slug(m.group(1).strip())))

    # each context's design document, converted through the same router the
    # per-context render uses, so the aggregate and the parts cannot diverge.
    for name, doc in docs:
        stem = "root" if name is None else name
        gen = os.path.join(gen_dir, "_agg_%s.typ" % stem)
        # resolve the destinations FIRST, in the markdown, then convert
        src_md = rewrite_md_links(open(doc, encoding="utf-8").read(), stem, known)
        md_tmp = os.path.join(gen_dir, "_agg_%s.md" % stem)
        with open(md_tmp, "w", encoding="utf-8") as f:
            f.write(src_md)
        cleanup.append(md_tmp)
        rc = subprocess.call([sys.executable, os.path.join(HERE, "md-to-typst"),
                              md_tmp, gen, "--lib", rel_lib])
        if rc != 0:
            return 2
        cleanup.append(gen)
        # strip the per-document shell: the aggregate supplies one shell for
        # the whole layer, and a nested page-setup would fight it.
        src = open(gen, encoding="utf-8").read()
        src = re.sub(r'^#import "[^"]*": \*\n', "", src, count=1)
        src = re.sub(r"^#show: design-doc\.with\((?:.|\n)*?^\)\n", "", src,
                     count=1, flags=re.M)
        # A section label is unique only WITHIN its document — every context has
        # a "00 Foundation" — so inside one document it must carry its chapter.
        # Typst rejects a duplicate label outright, so this is a build error, not
        # a cosmetic clash.
        src = re.sub(r"<sec-([^>]+)>", r"<sec-%s-\1>" % stem, src)
        fm = read_frontmatter(doc)
        title = fm.get("hero_title") or (stem + " context")
        # the chapter front page shows what the chapter contains, read from the
        # authored spine rather than from a hand-kept list.
        index = [_router.strip_spine_number(m.group(1))
                 for m in re.finditer(r"^##\s+(.+?)\s*$",
                                      open(doc, encoding="utf-8").read(), re.M)]
        parts.append((title, stem, src, fm.get("lede"), fm.get("accent"), index))

    terms = glossary_terms(root)

    # ---- assemble one document --------------------------------------------
    L = ['#import "%s": *' % rel_lib, ""]
    L.append("#show: aggregate-doc.with(")
    L.append('  title: [Design layer],')
    L.append('  subtitle: [the whole layer, as one document],')
    L.append(")")
    L.append("")
    for title, stem, src, lede, accent, index in parts:
        # the front page first, then the heading it announces: the heading stays
        # the renderer's (numbered, in the outline), the page is the separation.
        #
        # The lede and the section titles are authored markdown — they carry
        # bold, links, and code spans — so they go through the router and are
        # emitted as CONTENT blocks. Passing them as quoted strings would print
        # the raw markup on the page, which is the corruption class the router's
        # own span discipline exists to prevent.
        L.append("#chapter-page(%s, lede: %s, accent: %s, index: %s, kind: %s)"
                 % ("[" + inline(title) + "]",
                    "[" + inline(lede) + "]" if lede else "none",
                    _typ_str(accent) if accent else "none",
                    "(" + ", ".join("[" + inline(s) + "]" for s in index)
                    + ("," if len(index) == 1 else "") + ")",
                    _typ_str("root design" if stem == "root" else "context")))
        L.append("#pagebreak()")
        # The context's OWN `# Title` is the chapter. A synthetic `= title` was
        # emitted here once, purely to carry the <ctx-stem> label that a
        # cross-document link resolves against — and it cost a chapter number:
        # every context showed twice in the outline, an empty divider chapter
        # followed by the real one, both on the same page. A Typst label
        # attaches to a heading that already exists, so the label moves onto the
        # authored H1 and the extra heading goes away.
        #
        # A document with no H1 of its own still needs the anchor, so the
        # synthetic heading remains its fallback.
        # Typst permits ONE label per element, and the authored H1 already
        # carries its section label. A cross-document link may name the chapter
        # either way — by context (<ctx-stem>) or by that section anchor — so a
        # zero-width metadata anchor carries the context label beside the
        # heading rather than competing for its slot.
        m_h1 = re.search(r"^= .*$", src, re.M)
        if m_h1:
            src = (src[:m_h1.end()]
                   + "\n#metadata(none) <ctx-%s>" % stem
                   + src[m_h1.end():])
        else:
            L.append("= %s <ctx-%s>" % (inline(title), stem))
        L.append(src)
    if terms:
        L.append("= Glossary <glossary>")
        L.append("Every term the layer declares, with the context that owns it.")
        L.append("")
        for t in sorted(terms, key=lambda x: x["title"].lower()):
            # The term heading stays a real heading — it keeps its label, so
            # every #term- citation still jumps here, and it keeps its place in
            # the numbering. It is only kept OUT OF THE OUTLINE: 81 of the
            # document's 121 outline entries were term names, so the table of
            # contents was two pages of glossary with the design's own 40
            # sections buried inside it. The Glossary chapter itself stays
            # listed, which is what a reader navigates to.
            L.append('#heading(level: 2, outlined: false)[%s] %s'
                     % (inline(t["title"]), "<%s>" % t["slug"]))
            L.append("#context-owner(%s)" % _typ_str(t["context"]))
            # A glossary body cites its siblings the same way a design document
            # does — mostly as a BARE `#term-x` anchor, since inside one
            # CONTEXT.md the file is implied — so it needs the same rewrite. It
            # was missed at first, which left the glossary's own cross-references
            # dead while the design documents' worked.
            # a term's definition is a prose run; its destinations are resolved
            # in the markdown, exactly as a design document's are.
            body = rewrite_md_links("\n".join(t["body"]).strip(),
                                    t["context"], known)
            L.append(prose(body))
            L.append("")

    agg = os.path.join(gen_dir, "_aggregate.typ")
    open(agg, "w", encoding="utf-8").write("\n".join(L) + "\n")
    cleanup.append(agg)

    return compile_and_verify(agg, root, out_pdf, check, lib, cleanup,
                              len(parts), len(terms))


def _typ_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


if __name__ == "__main__":
    sys.exit(main())
