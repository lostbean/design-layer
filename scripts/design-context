#!/usr/bin/env python3
"""Project a Typst design layer into ephemeral agent-context Markdown."""

from __future__ import annotations

import hashlib
import json
import importlib.util
from importlib.machinery import SourceFileLoader
import math
import os
import re
import subprocess
import sys
import tempfile
from collections.abc import Mapping
from dataclasses import dataclass
from pathlib import Path
from typing import NoReturn

from typst_policy import command as typst_command
from typst_policy import environment as typst_environment


USAGE = (
    "usage: design-context <layer-root> "
    "[--estimate | --manifest | --preview [--depth N] | --section PATH "
    "| --unit ID | --path REPO-PATH] "
    "[--output PATH] [--expect-digest DIGEST]"
)
# The modes that emit one selected part of the projection. They share the
# output and digest-guard behaviour, so every rule about them names this set.
SELECTOR_MODES = frozenset({"section", "unit", "path"})
LABEL = "<design-semantic>"
# A guideline note is a diagnostic the compile records for `lint`; it is never
# document content, and `render` and `check` accept a layer that carries one.
GUIDELINE_LABEL = "<design-guideline>"
MANIFEST_FORMAT = "design-context-manifest/v1"

# Layout-only wrappers. They place, rotate, or paginate content without adding
# meaning, so the projection walks through them to the content they carry. A
# landscape page written as `#page(flipped: true)[...]` arrives here as a
# `page` around the body plus the `flush` and `pagebreak` markers the page
# change introduces; neither marker has content.
LAYOUT_CARRIERS = frozenset(
    {
        "align",
        "block",
        "box",
        "columns",
        "move",
        "pad",
        "page",
        "place",
        "rotate",
        "scale",
        "stack",
    }
)
LAYOUT_MARKERS = frozenset({"colbreak", "flush", "pagebreak", "v", "h"})


def layout_child(value: dict[str, object]) -> object:
    return value.get("body", value.get("children", value.get("child")))


SEMANTIC_FIELDS = {
    "document": {"name", "level", "title", "body", "context-command"},
    "term": {"owner", "slug", "title", "body"},
    "section": {"title", "lead", "visual", "notes", "body"},
    "answers": {"title", "accent", "answers"},
    "components": {"accent", "items"},
    "contract": {"name", "lens", "mission", "answers", "body", "accent", "tint"},
    "entity": {"id", "title", "description", "entity-kind", "owner", "lifecycle", "domain", "lens", "tint", "body"},
    "attribute": {"id", "provenance", "name", "type", "state-type", "state-machine", "body"},
    "relates": {"cardinality", "body"},
    "cards": {"tint", "size", "items"},
    "coverage": {"rows"},
