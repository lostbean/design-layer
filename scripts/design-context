#!/usr/bin/env python3
"""Project a Typst design layer into ephemeral agent-context Markdown."""

from __future__ import annotations

import json
import importlib.util
from importlib.machinery import SourceFileLoader
import math
import os
import re
import subprocess
import sys
import tempfile
from collections.abc import Mapping
from pathlib import Path
from typing import NoReturn

from typst_policy import command as typst_command
from typst_policy import environment as typst_environment


USAGE = "usage: design-context <layer-root> [--estimate | --output PATH]"
LABEL = "<design-semantic>"

SEMANTIC_FIELDS = {
    "document": {"name", "level", "title", "body"},
    "term": {"owner", "slug", "title", "body"},
    "section": {"title", "lead", "visual", "notes", "body"},
    "answers": {"title", "accent", "answers"},
    "components": {"accent", "items"},
    "contract": {"name", "lens", "mission", "answers", "body", "accent", "tint"},
    "entity": {"id", "title", "description", "entity-kind", "owner", "lifecycle", "domain", "lens", "tint", "body"},
