    "relates": {"cardinality", "body"},
    "cards": {"tint", "size", "items"},
    "coverage": {"rows"},
    "md-table": {"ncol", "cells"},
    "stat-grid": {"cols", "tiles"},
    "how-to-read": {"accent"},
    "diagram": {"altitude", "title", "caption", "accent", "layout", "flow", "spacing", "viewpoint", "groups", "nodes", "edges"},
    "diagram-native": {"altitude", "title", "caption", "accent", "layout", "flow", "spacing", "viewpoint", "groups", "nodes", "edges"},
    "chart": {"chart-kind", "title", "caption", "accent", "points", "unit"},
    "code-block": {"lang", "src"},
    "formula": {"id", "title", "caption", "numbered", "notation", "body"},
    "state-type": {"id", "title", "variants"},
    "state-machine": {"id", "subject", "state-field", "state-type", "title", "caption", "accent", "flow", "states", "transitions", "initial", "accepting"},
    "sequence": {"title", "caption", "accent", "participants", "steps"},
