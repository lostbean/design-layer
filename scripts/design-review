#!/usr/bin/env python3
"""Review evaluated changes between two Typst design revisions."""

from argparse import ArgumentParser
from concurrent.futures import ThreadPoolExecutor
from contextlib import ExitStack
from dataclasses import dataclass
from pathlib import Path
from tempfile import TemporaryDirectory, TemporaryFile
import json
import os
import shutil
import subprocess
import sys
import tarfile

from design_output import write_new_output
from design_pdf import query_places, render_layer
from design_semantics import query_file, query_layer
from design_source import (
    LayerSource,
    ProjectionError,
    ProjectionOperationalError,
    projection_layer,
    renderer_library,
)
from review_model import compare, coverage, empty_notice, part_outline, render_summary
from review_pdf import Side, compose
from typst_policy import command as typst_command, environment as typst_environment


def git(directory: Path, *args: str) -> bytes:
    return subprocess.run(
        ["git", "-C", str(directory), *args], check=True, capture_output=True
    ).stdout


def base_snapshot(entry: Path, revision: str, scratch: Path) -> tuple[Path, str]:
    directory = entry if entry.is_dir() else entry.parent
    root = Path(
        os.fsdecode(git(directory, "rev-parse", "--show-toplevel").removesuffix(b"\n"))
    )
    relative = entry.relative_to(root.resolve())
    commit = (
        git(root, "rev-parse", "--verify", "--end-of-options", f"{revision}^{{commit}}")
        .decode()
        .strip()
    )
    checkout = scratch / "base"
    checkout.mkdir()
    command = ["git", "-C", str(root), "archive", "--format=tar", commit]
    # Git supplies the source snapshot. Stream the archive into its temporary
    # checkout so a large repository never needs a second copy of the archive.
    with (
        TemporaryFile() as diagnostics,
        subprocess.Popen(
            command, stdout=subprocess.PIPE, stderr=diagnostics
        ) as process,
    ):
        assert process.stdout is not None
        try:
            with tarfile.open(fileobj=process.stdout, mode="r|") as archive:
                archive.extractall(checkout, filter="data")
            while process.stdout.read(64 * 1024):
                pass
        except tarfile.ReadError:
            # Git can fail before writing a tar header. Close the pipe before
            # waiting in case a failed extraction left unread archive data.
            process.stdout.close()
            status = process.wait()
            diagnostics.seek(0)
            message = diagnostics.read()
            if status and message:
                raise subprocess.CalledProcessError(
                    status, command, stderr=message
                ) from None
            raise
        status = process.wait()
        if status:
            diagnostics.seek(0)
            raise subprocess.CalledProcessError(
                status, command, stderr=diagnostics.read()
            )
    return (checkout / relative).resolve(), commit[:12]


def prepare_library(directory: Path) -> None:
    projected = directory / ".render"
    library = os.environ.get("DESIGN_LIB_DIR")
    if not library or projected.exists():
        return
    # Publish the library as a complete directory for concurrent reviews.
    with TemporaryDirectory(prefix=".review-render-", dir=directory) as scratch:
        staged = Path(scratch) / "render"
        shutil.copytree(library, staged)
        staged.chmod(0o755)
        try:
            staged.rename(projected)
        except OSError:
            if not (projected / "designlib.typ").is_file():
                raise


@dataclass(frozen=True)
class Revision:
    entry: Path
    source: LayerSource | None = None
    library: Path | None = None

    @classmethod
    def prepare(cls, entry: Path) -> "Revision":
        if entry.is_dir():
            prepare_library(entry)
            library = renderer_library(entry)
            local = entry / ".render" / "designlib.typ"
            return cls(
                entry,
                projection_layer(entry),
                local.resolve() if local.is_file() else library,
            )
        if not entry.is_file():
            raise ValueError(f"design source does not exist: {entry}")
        if entry.suffix != ".typ":
            raise ValueError(
                f"expected a design layer directory or Typst entry point: {entry}"
            )
        prepare_library(entry.parent)
        if os.environ.get("DESIGN_LIB_DIR"):
            renderer_library(entry.parent)
        return cls(entry)

    @classmethod
    def absent(cls, entry: Path) -> "Revision":
        """A base revision with nothing at the path, such as one before adoption."""
        return cls(entry, LayerSource(entry, ()))

    @property
    def empty(self) -> bool:
        """A layer without design documents has no records and no document."""
        return self.source is not None and not self.source.documents

    def evaluate(self) -> list[object]:
        if self.empty:
            return []
        if self.source is not None:
            assert self.library is not None
            return query_layer(self.source, self.library, review=True)
        records = query_file(self.entry, review=True)
        if not records:
            raise ValueError(f"no structured design records in {self.entry}")
        return records

    def render(self, target: Path) -> list[object]:
        """Render the revision and report where each part of it was drawn."""
        places: list[object] = []
        if self.source is not None:
            assert self.library is not None
            if render_layer(self.source, target, False, self.library, places=places):
                raise ValueError(f"could not render {self.entry}")
            return places
        env = typst_environment()
        subprocess.run(
            [
                typst_command(),
                "compile",
                str(self.entry),
                str(target),
                "--input",
                "review-places=1",
            ],
            check=True,
            capture_output=True,
            text=True,
            env=env,
        )
        return query_places(str(self.entry), None, env)


def render_sides(pool, revisions, records, scratch):
    """Render each side that has a design document, and read its layout."""
    before, after = revisions["before"], revisions["after"]
    names = ["before"] if before is after else ["before", "after"]
    drawn = [name for name in names if not revisions[name].empty]
    targets = {name: scratch / f"{name}.pdf" for name in drawn}
    # Typst runs for both sides at once. The PDF library is not safe across
    # threads, so the rendered documents are opened here, one after the other.
    places = dict(
        zip(drawn, pool.map(lambda name: revisions[name].render(targets[name]), drawn))
    )
    sides = {
        name: Side.read(name, targets[name], places[name], part_outline(records[name]))
        if name in targets
        else Side.absent(name)
        for name in names
    }
    return (
        sides
        if len(names) == 2
        else {"before": sides["before"], "after": sides["before"]}
    )


def main(argv):
    parser = ArgumentParser(description=__doc__)
    parser.add_argument("before", type=Path)
    parser.add_argument("after", type=Path, nargs="?")
    parser.add_argument(
        "--base", help="compare the working-tree path against a Git revision"
    )
    parser.add_argument(
        "--format",
        choices=("pdf", "json"),
        default="pdf",
        help="pdf: one side-by-side PDF for a reader. json: the report for an agent",
    )
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        help="the PDF to write, or the file that receives the JSON report",
    )
    parser.add_argument(
        "--summary",
        type=Path,
        help="also write a Markdown summary, sized for one pull request comment",
    )
    args = parser.parse_args(argv)
    if (args.after is None) == (args.base is None):
        parser.error("supply two paths or one working-tree path with --base")
    as_pdf = args.format == "pdf"
    if as_pdf and args.output is None:
        parser.error("-o names the PDF to write; --format json prints a report")

    try:
        for path in [args.output, args.summary]:
            if path is not None and (path.exists() or path.is_symlink()):
                raise ValueError(f"output already exists: {path}")

        with ExitStack() as work:
            scratch = None
            if args.base is not None or as_pdf:
                scratch = Path(
                    work.enter_context(TemporaryDirectory(prefix="design-review-"))
                )
            pool = work.enter_context(ThreadPoolExecutor(max_workers=2))
            after_entry = (args.after or args.before).resolve()
            if args.base is not None:
                assert scratch is not None
                # The working tree must hold the layer even when the base has
                # none, so prepare it before extracting the base.
                after = Revision.prepare(after_entry)
                before_entry, base_label = base_snapshot(
                    after_entry, args.base, scratch
                )
                # A base from before the layer was adopted has nothing at
                # the path. It is an empty layer, so the adopting change
                # reviews as added.
                before = (
                    Revision.prepare(before_entry)
                    if before_entry.exists()
                    else Revision.absent(before_entry)
                )
            else:
                before_entry, base_label = args.before.resolve(), str(args.before)
                before = Revision.prepare(before_entry)
                after = (
                    before
                    if before_entry == after_entry
                    else Revision.prepare(after_entry)
                )
            if before is after:
                old = new = before.evaluate()
            else:
                old, new = pool.map(Revision.evaluate, (before, after))

            sides = (
                {"before": before}
                if after is before
                else {"before": before, "after": after}
            )
            empty = [side for side, revision in sides.items() if revision.empty]
            changes = compare(old, new)
            before_coverage = coverage(old)
            report = {
                "format": "design-review/v1",
                "sources": {
                    "before": base_label,
                    "after": str(args.after or args.before),
                },
                "changes": changes,
                "coverage": {
                    "before": before_coverage,
                    "after": before_coverage if old is new else coverage(new),
                },
            }
            pdf_error = None
            composed = None
            if as_pdf:
                assert scratch is not None
                try:
                    drawn = render_sides(
                        pool,
                        {"before": before, "after": after},
                        {"before": old, "after": new},
                        scratch,
                    )
                    composed = scratch / "design-review.pdf"
                    notices = [empty_notice(report["sources"][side]) for side in empty]
                    if any(report["coverage"].values()):
                        notices.append(
                            "Native figures and mathematical equivalence "
                            "may require manual review."
                        )
                    compose(report, drawn, notices, composed)
                # Whatever stops the PDF, the summary is still owed: the
                # comment on the pull request is written from it.
                except Exception as error:
                    detail = getattr(error, "stderr", None) or str(error)
                    pdf_error = f"the side-by-side PDF could not be rendered: {detail}"
                    print(f"design-review: {pdf_error}", file=sys.stderr)

            if args.summary:
                write_new_output(
                    args.summary,
                    render_summary(report, pdf_error, empty=empty).encode(),
                )
            if as_pdf:
                if pdf_error is None:
                    assert composed is not None
                    with composed.open("rb") as stream:
                        write_new_output(args.output, stream)
            else:
                text = json.dumps(report, indent=2, ensure_ascii=False) + "\n"
                if args.output:
                    write_new_output(args.output, text.encode())
                else:
                    sys.stdout.write(text)
        return 2 if pdf_error else 0
    except (
        ValueError,
        OSError,
        tarfile.TarError,
        subprocess.CalledProcessError,
        ProjectionError,
        ProjectionOperationalError,
    ) as error:
        message = getattr(error, "stderr", None) or str(error)
        if isinstance(message, bytes):
            message = message.decode(errors="replace")
        print(f"design-review: {message.strip()}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
