#!/usr/bin/env python3
#
# layer-integrity — cross-artifact link checker for a TARGET repo's design
# layer (design docs + CONTEXT + ADRs). Checks mechanical well-formedness:
#
#   1. Link resolution, fail-closed — in every design.typ, CONTEXT.typ and
#      CONTEXT-MAP.md, every design-ish link (per the schema's
#      design_ish_markers) must resolve: file exists AND the anchor exists
#      (adr: a line matching the schema element_regex). A near-miss (#term-
#      with no slug, a #trem- typo, a malformed adr id) is a violation, never
#      a skip.
#   2. ADR lockstep — every file in the ADR dir matches the schema filename
#      pattern and contains exactly one anchor element whose NNNN equals the
#      filename's NNNN.
#   3. Term anchor validity — every term slug a CONTEXT.typ declares matches
#      the schema term id pattern; duplicates within one file are violations.
#   4. Map totality (multi-context) — with 2+ CONTEXT.typ files, CONTEXT-MAP.md
#      exists and links every CONTEXT.typ by exact relative path, and the root
#      design doc names every context design doc with a ctx() call.
#   5. No orphan design.pdf — retired; check 8 subsumes it.
#   6. No verbatim-duplicate prose within one design.typ or CONTEXT.typ — the
#      mechanical shadow of "cross-links, never restatement". The unit is the
#      PROSE a content block carries, not the source line, because a repeated
#      call line is the syntax working. Citation-only fragments and short
#      fragments are exempt.
#   7. No generation debris — a generation-wrapper artifact line (per the
#      schema's generation_debris_patterns, e.g. a literal '</content>') in
#      any layer artifact (design.typ, CONTEXT.typ, CONTEXT-MAP.md,
#      COVERAGE.md, ADRs) is writer leakage, never content. Fenced code blocks
#      are exempt (an example is documentation).
#   8. Layer homing — every layer basename (design.typ, design.pdf,
#      CONTEXT.typ, CONTEXT-MAP.md, COVERAGE.md) sits at a home declared by the
#      schema's layer_layout.homing: the layer lives entirely under docs/,
#      never colocated into source directories. A layer file outside its home
#      is a mishomed stray. (ADR homing is check 2's concern via the ADR dir.)
#
# Plus one ADVISORY (never a check; exit codes untouched): when the repo has
# moved schema-threshold+ commits since any layer artifact last changed, one
# line recommends reconciling before relying on the layer
# (schema layer_layout.staleness_advisory; tolerate-absent for older copies).
#
# Usage: layer-integrity [repo-root]     (default: .)
#
# SHAPE — parse once, then answer every check as a lookup.
# The gate reads each layer file exactly ONCE, into an index of its lines,
# fence-stripped lines, term anchors, ADR anchor elements, and outbound links.
# Every check is then a function over already-parsed data, never a function
# that reads a file. That is why this is one python program and not a shell
# script driving per-match subprocesses: the one-process shape removes the
# spawn cost, and the parse-once shape removes the re-scan cost. A check added
# later cannot reintroduce the re-scan, because there is no per-link file read
# to copy.
#
# Discovery prunes dot-dirs, node_modules, and — when the root is a git
# repo — gitignored paths (a gitignored tree is not part of the system).
# Non-git roots are scanned in full.
#
# The schema is located via $DESIGN_SCHEMA if set, else the script-sibling
# design-schema.json (the copy-installed layout per the schema's
# scripts_contract.distribution), else schema/design-schema.json relative to
# this script's own realpath's repo (the framework layout); exit 2 when none
# resolves.
# Anchor patterns (term id + heading regex, adr id + filename + element regex)
# and the design-ish link markers all come from the schema — never hardcoded.
# Schema regexes are python-re flavored (their flavor uses \s, which BSD
# grep's ERE does not support), and this program is the matching engine.
#
# Exit 0: clean. Exit 1: at least one violation (one report line each: file,
# what, why). Exit 2: usage/IO error — including "no design layer" when the
# target repo has no design artifacts at all (sync branches on that message).
#
# ONE FILE, STANDARD LIBRARY ONLY. The script is copy-installed on its own
# into host repos that have python3 and git and nothing else.

import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass, field
from typing import Optional


# --- Violation reporting ------------------------------------------------------


class Report:
    """Collects violations, and counts what each check actually MATCHED.

    THE COUNT IS THE ANTI-VACUITY GUARD. A pattern-based check reports the same
    clean line whether it examined seven hundred references or none at all, so
    a check that silently matches nothing is indistinguishable from a check
    that passed — and that is the failure mode this whole class of gate keeps
    reproducing. A marker list that lost an extension, an indexer handed a
    notation it does not parse, a scan whose pattern stopped matching: each
    reported OK over an empty set.

    Every check therefore records how many items it resolved, and the summary
    prints those numbers. `assert_nonzero` turns the ones that must never be
    empty into failures rather than silence.
    """

    def __init__(self) -> None:
        self.found = False
        self.counts: dict = {}

    def violation(self, file: str, what: str, why: str) -> None:
        print(f"violation: {file}: {what}: {why}")
        self.found = True

    def matched(self, what: str, n: int = 1) -> None:
        self.counts[what] = self.counts.get(what, 0) + n

    def assert_nonzero(self, what: str, why: str) -> None:
        """A check that matched nothing examined nothing, and must say so."""
        if not self.counts.get(what):
            print(f"violation: {what}: matched nothing: {why}")
            self.found = True


def die(message: str) -> "None":
    print(message, file=sys.stderr)
    sys.exit(2)


# --- Schema: the declared contracts, parsed once ------------------------------


@dataclass(frozen=True)
class DesignIshMarkers:
    """The schema's design_ish_markers, split by how each one matches.

    A marker starting with "re:" is a regex matched against the whole
    destination; a marker ending in "/" is a directory (matched against the
    link's resolved target path); a marker containing "#" is matched as a
    substring of the whole destination; anything else matches the target's
    basename exactly.
    """

    regexes: tuple = ()
    dirs: tuple = ()
    substrings: tuple = ()
    basenames: tuple = ()

    @staticmethod
    def parse(markers) -> "DesignIshMarkers":
        regexes, dirs, substrings, basenames = [], [], [], []
        for m in markers:
            if m.startswith("re:"):
                regexes.append(re.compile(m[3:]))
            elif m.endswith("/"):
                dirs.append(m[:-1])
            elif "#" in m:
                substrings.append(m)
            else:
                basenames.append(m)
        return DesignIshMarkers(
            tuple(regexes), tuple(dirs), tuple(substrings), tuple(basenames)
        )


@dataclass(frozen=True)
class Schema:
    """Every layer contract this gate reads, resolved once at startup."""

    term_id_re: "re.Pattern"
    # A link into a SECTION of a design document. Tolerate-absent, like the
    # staleness advisory: an older copy-installed schema without anchors.section
    # gets None and the check falls back to the pre-existing term/adr-only
    # behavior rather than dying.
    section_id_re: "typing.Optional[re.Pattern]"
    adr_id_re: "re.Pattern"
    adr_id_src: str
    adr_file_re: "re.Pattern"
    adr_file_src: str
    adr_element_re: "re.Pattern"
    adr_element_src: str
    term_id_src: str
    adr_dir_rel: str
    root_design_rel: str
    map_rel: str
    markers: DesignIshMarkers
    debris: tuple  # (compiled, source) pairs — the source names the pattern
    homes: dict
    context_segment_re: "re.Pattern"
    staleness_threshold: Optional[int]
    # None when the schema copy predates the key (tolerate-absent); an empty
    # tuple would mean "declared, but no pattern", which is a different thing.
    supersession_res: Optional[tuple]


def locate_schema(argv0: str) -> str:
    """The lookup chain: $DESIGN_SCHEMA, then the script-sibling copy (the
    copy-installed layout), then ../schema/ (the framework layout)."""
    override = os.environ.get("DESIGN_SCHEMA")
    if override:
        return override
    self_dir = os.path.dirname(os.path.realpath(argv0))
    sibling = os.path.join(self_dir, "design-schema.json")
    if os.path.isfile(sibling):
        return sibling
    return os.path.join(self_dir, "..", "schema", "design-schema.json")


CONTRACT_ERROR = (
    "requires anchors.term.id_pattern, "
    "anchors.adr.{id_pattern,filename_pattern,element_regex}, "
    "layer_layout.{adr_dir,entry_points}"
)


def load_schema(path: str) -> Schema:
    """Parse the schema at the boundary into typed contracts. Any missing or
    unusable contract is an exit-2 error here, never a silently skipped
    check downstream."""
    if not os.path.isfile(path):
        die(
            f"error: design schema not found: {path} "
            "(set DESIGN_SCHEMA to the framework's schema/design-schema.json)"
        )
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except (OSError, ValueError):
        die(
            f"error: cannot read layer contracts from schema: {path} ({CONTRACT_ERROR})"
        )

    def entry_point_matching(suffix: str) -> str:
        return [p for p in raw["layer_layout"]["entry_points"] if p.endswith(suffix)][0]

    try:
        anchors = raw["anchors"]
        layout = raw["layer_layout"]
        term_id_src = anchors["term"]["id_pattern"]
        adr_id_src = anchors["adr"]["id_pattern"]
        adr_file_src = anchors["adr"]["filename_pattern"]
        adr_element_src = anchors["adr"]["element_regex"]
        section_src = (anchors.get("section") or {}).get("id_pattern")
        adr_dir_rel = layout["adr_dir"]
        root_design_rel = entry_point_matching("design.typ")
        map_rel = entry_point_matching("CONTEXT-MAP.md")
    except (KeyError, IndexError, TypeError):
        die(
            f"error: cannot read layer contracts from schema: {path} ({CONTRACT_ERROR})"
        )

    markers_raw = layout.get("design_ish_markers") or []
    if not markers_raw:
        die(
            f"error: cannot read layer contracts from schema: {path} "
            "(requires a non-empty layer_layout.design_ish_markers)"
        )

    debris_raw = layout.get("generation_debris_patterns") or []
    if not debris_raw:
        die(
            f"error: cannot read layer contracts from schema: {path} "
            "(requires a non-empty layer_layout.generation_debris_patterns)"
        )

    # The homing contract is required, checked up front so a pre-homing schema
    # copy fails loudly (exit 2) instead of silently skipping check 8.
    homing = layout.get("homing")
    if (
        not isinstance(homing, dict)
        or "homes" not in homing
        or "context_segment" not in homing
    ):
        die(
            f"error: cannot read layer contracts from schema: {path} "
            "(requires layer_layout.homing.{homes,context_segment})"
        )

    # The staleness advisory is tolerate-absent: an older schema copy without
    # the key simply skips the advisory.
    threshold = None
    advisory = layout.get("staleness_advisory")
    if isinstance(advisory, dict) and "threshold_commits" in advisory:
        threshold = advisory["threshold_commits"]

    # The decision-citation advisory is tolerate-absent the same way. A schema
    # that declares the key with an empty pattern list is NOT the same as one
    # that omits it: the first says "no supersession is expressible in this
    # ledger", the second says "this copy is older than the advisory".
    supersession_res = None
    cite_adv = layout.get("decision_citation_advisory")
    if isinstance(cite_adv, dict) and "supersession_patterns" in cite_adv:
        supersession_res = tuple(
            re.compile(p) for p in cite_adv["supersession_patterns"]
        )

    return Schema(
        term_id_re=re.compile(term_id_src),
        section_id_re=re.compile(section_src) if section_src else None,
        adr_id_re=re.compile(adr_id_src),
        adr_id_src=adr_id_src,
        adr_file_re=re.compile(adr_file_src),
        adr_file_src=adr_file_src,
        adr_element_re=re.compile(adr_element_src),
        adr_element_src=adr_element_src,
        term_id_src=term_id_src,
        adr_dir_rel=adr_dir_rel,
        root_design_rel=root_design_rel,
        map_rel=map_rel,
        markers=DesignIshMarkers.parse(markers_raw),
        debris=tuple((re.compile(p), p) for p in debris_raw),
        homes=homing["homes"],
        context_segment_re=re.compile(homing["context_segment"]),
        staleness_threshold=threshold,
        supersession_res=supersession_res,
    )


# --- The file index: every layer file is read exactly once --------------------

FENCE_RE = re.compile(r"^[ \t]*(```|~~~)")
MERMAID_FENCE_RE = re.compile(r"^[ \t]*(```|~~~)[ \t]*mermaid")
CLICK_RE = re.compile(r"^[ \t]*click[ \t]")
QUOTED_RE = re.compile(r'"[^"]*"')
LINK_DEST_RE = re.compile(r"\]\(([^)]*)\)")
HEADING_RE = re.compile(r"^#{1,6}[ \t]")
ANCHOR_BRACE_RE = re.compile(r"\{#([^}]*)\}")
LOOSE_ANCHOR_RE = re.compile(r"<a[^>]*id=")

# The leading spine NUMBER of a heading — `02`, `02.1`, `04.0`, `08.2.1`. Only
# this prefix has its dots removed; see section_slug.
SECTION_NUMBER_RE = re.compile(r"^(\d+(?:\.\d+)*)")


def section_slug(text: str) -> str:
    """The rendered id of a spine heading, by the schema's declared rule
    (anchors.section.slug_rule): the heading text lowercased with runs of
    non-alphanumerics collapsed to single hyphens and THE NUMBERING'S DOT
    REMOVED — '02 The artifact trio' -> '02-the-artifact-trio', and
    '02.1 The pending ledger' -> '021-the-pending-ledger'.

    ONE FUNCTION, CALLED BY BOTH INDEXERS. The rule is a property of the
    anchor, not of the notation it was written in, so a link into a section
    must resolve identically whether the target is authored in Typst or in
    markdown. Stating it twice is how one side starts resolving while the other
    dangles, which is the defect this gate exists to catch rather than commit.

    The dot removal is SCOPED TO THE LEADING NUMBER, not applied to every dot in
    the heading. The schema calls it "the numbering's dot", and the numbering is
    the only place a dot joins two parts of one identifier: '02.1' is one
    section number and must render '021', because a hyphen there would read as
    the separator between the number and the title. Anywhere else a dot is
    ordinary punctuation — a title naming 'design.typ', or a sentence period —
    and collapses to a hyphen like any other non-alphanumeric run, which keeps
    'design.typ' as 'design-typ' rather than welding it into 'designtyp'.
    """
    stripped = text.strip()
    numbered = SECTION_NUMBER_RE.sub(
        lambda m: m.group(1).replace(".", ""), stripped, count=1
    )
    return re.sub(r"[^a-z0-9]+", "-", numbered.lower()).strip("-")


@dataclass
class FileIndex:
    """Everything the checks need to know about one layer file, derived from a
    single read. No check reopens the file."""

    path: str
    rel: str
    base: str
    lines: list = field(default_factory=list)  # every line, fences included
    stripped: list = field(default_factory=list)  # fenced code blocks removed
    link_dests: list = field(default_factory=list)  # raw destinations, stripped text
    click_dests: list = field(default_factory=list)  # mermaid `click` targets
    term_anchor_ids: list = field(default_factory=list)  # declared term slugs
    adr_elements: list = field(default_factory=list)  # lines matching element_regex
    loose_anchor_count: int = 0  # anchor-ish lines, matched or not
    declared_terms: set = field(default_factory=set)  # well-formed slugs declared here
    adr_anchor_frags: set = field(default_factory=set)  # ids inside anchor elements
    html_ids: set = field(default_factory=set)  # id="..." in an .html file
    section_ids: set = field(default_factory=set)  # rendered ids of spine headings
    adr_calls: list = field(default_factory=list)  # (line_no, N) from #adr(N)
    term_cites: list = field(default_factory=list)  # (line_no, slug) #term("…")
    ctx_cites: list = field(default_factory=list)  # (line_no, name) #ctx("…")


def read_lines(path: str) -> list:
    with open(path, encoding="utf-8", errors="replace") as fh:
        return fh.read().splitlines()


def index_markdown(path: str, rel: str, schema: Schema) -> FileIndex:
    """Read one markdown layer file and build every index a check needs.

    This is the single place a layer file is opened. Fence stripping, link and
    click-target extraction, term anchors, and ADR anchor elements all come out
    of the one pass; the checks then look up, never re-scan.
    """
    idx = FileIndex(path=path, rel=rel, base=os.path.basename(path))
    idx.lines = read_lines(path)

    in_fence = False
    in_mermaid = False
    for lineno, line in enumerate(idx.lines, 1):
        if FENCE_RE.match(line):
            # A fence line toggles the block. A mermaid opener additionally
            # arms click-target extraction for the block it opens.
            if not in_fence and MERMAID_FENCE_RE.match(line):
                in_mermaid = True
            else:
                in_mermaid = False
            in_fence = not in_fence
            continue
        if in_fence:
            if in_mermaid and CLICK_RE.match(line):
                # `click NODE "target" "optional tooltip"` — the first quoted
                # string is the destination; a bare `click NODE href` form uses
                # the first whitespace token after the node.
                quoted = QUOTED_RE.search(line)
                if quoted:
                    dest = quoted.group(0)[1:-1]
                else:
                    fields = line.split()
                    dest = fields[2] if len(fields) > 2 else ""
                if dest:
                    idx.click_dests.append(dest)
            continue

        idx.stripped.append(line)

        for m in LINK_DEST_RE.finditer(line):
            idx.link_dests.append(m.group(1))

        if HEADING_RE.match(line):
            for m in ANCHOR_BRACE_RE.finditer(line):
                idx.term_anchor_ids.append(m.group(1))
            # The rendered id of a spine heading: drop the leading #s and any
            # explicit {#anchor}, then slugify by the schema's declared rule
            # (anchors.section.slug_rule), which section_slug owns for both
            # notations. '## 02.1 The pending ledger' -> '021-the-pending-ledger'.
            #
            # That example is what this comment always claimed and what the code
            # here did NOT do: it collapsed the numbering's dot to a hyphen and
            # produced '02-1-the-pending-ledger', so a COVERAGE.md link written
            # to the schema was reported dangling. The schema is the authority,
            # and the call below is now the only statement of the rule.
            _text = re.sub(r"^#+\s*", "", line).strip()
            _text = ANCHOR_BRACE_RE.sub("", _text)
            _slug = section_slug(_text)
            if _slug:
                idx.section_ids.add(_slug)

        if schema.adr_element_re.search(line):
            idx.adr_elements.append(line)
        if LOOSE_ANCHOR_RE.search(line):
            idx.loose_anchor_count += 1

    return idx


# --- The Typst authoring surface ---------------------------------------------
#
# A Typst-authored layer states the same facts a markdown one does, in calls
# rather than in markup, so the same checks answer the same questions against a
# different notation.
#
#   an ADR citation      #adr(64)                  -> the number, validated
#                                                     against the ADR dir
#   a term declaration   (slug: "term-x", ...)     -> the declared vocabulary
#   a section            #section(title: "02.1 …") -> the slug a link targets
#
# An ADR citation stays a REAL LINK into the markdown ADR, because the ADRs
# remain markdown and a citation must resolve to a file a reader can open. What
# the call buys is that the NUMBER is checkable at the citing line, rather than
# a path that silently rots when a file is renamed.
TYPST_ADR_RE = re.compile(r"\badr\(\s*(\d+)\s*\)")
# A term DECLARATION, matched by its shape rather than by its validity. The
# capture is deliberately permissive — any slug value at all — because a regex
# that only matches a WELL-FORMED slug cannot report a malformed one: the bad
# declaration simply fails to match, is never indexed, and disappears. Check 3
# validates what this collects, so collecting must be the wider of the two.
TYPST_TERM_RE = re.compile(r'slug:\s*"([^"]*)"')
# The subset that is actually a well-formed term id. Only these become citable
# anchors; a malformed one is collected above and reported by check 3.
TYPST_TERM_OK_RE = re.compile(r"^term-[a-z0-9]+(?:-[a-z0-9]+)*$")
# A SECTION HEADING, matched against the WHOLE SOURCE rather than per line. The
# real authoring style opens a section across several lines —
#
#   #section(
#     title: "04 The catalog gate",
#
# — and `\s*` inside a per-line scan can never cross the newline, so every
# multi-line section fell out of the anchor index while the single-line spelling
# stayed in. Measured on a real layer: 4 of 10 sections indexed, and every
# cross-document link into one of the other 6 was reported as a dangling section
# anchor. A section title needs no line number (the anchor set is a set of
# slugs, and a violation names the TARGET file, not the heading's line), so this
# one index is built off the joined source while everything that does need a
# line number stays in the per-line loop.
TYPST_SECTION_RE = re.compile(r'(?:sub)?section\(\s*title:\s*"([^"]*)"')
TYPST_LINK_RE = re.compile(r'link\(\s*"([^"]*)"')
TYPST_LINE_COMMENT_RE = re.compile(r"//.*$")
# A CITATION, as opposed to a declaration. `#term("term-x")` names a term
# another file declares and `#ctx("name")` names a context directory; both are
# cross-references, and the whole reason the notation is a call is that the
# name is checkable at the citing line.
TYPST_TERM_CITE_RE = re.compile(r'#term\(\s*"([^"]*)"\s*\)')
TYPST_CTX_CITE_RE = re.compile(r'#ctx\(\s*"([^"]*)"')


def index_typst(path: str, rel: str, schema: Schema) -> FileIndex:
    """Read one Typst layer file and build the same indexes the checks need.

    The section slug is derived by THE SAME RULE the markdown side uses, and
    now by literally the same function: both call section_slug, which owns the
    schema's anchors.section.slug_rule. A link written against either notation
    therefore resolves identically — '02.1 The pending ledger' ->
    '021-the-pending-ledger'. Two slug rules for one concept is how a cross-link
    starts resolving on one side and dangling on the other, and for a while the
    two sides agreed only because both were wrong in the same way.
    """
    idx = FileIndex(path=path, rel=rel, base=os.path.basename(path))
    idx.lines = read_lines(path)

    for lineno, raw in enumerate(idx.lines, 1):
        # A line comment is prose about the source, not a claim the layer makes.
        line = TYPST_LINE_COMMENT_RE.sub("", raw)
        idx.stripped.append(line)

        for m in TYPST_ADR_RE.finditer(line):
            idx.adr_calls.append((lineno, int(m.group(1))))
        for m in TYPST_TERM_RE.finditer(line):
            slug = m.group(1)
            # EVERY declaration is collected for validation; only a well-formed
            # one becomes an anchor a citation may resolve against. Indexing a
            # malformed slug as an anchor would make a citation of it resolve,
            # which would hide the defect at both ends.
            idx.term_anchor_ids.append(slug)
            if TYPST_TERM_OK_RE.match(slug):
                idx.declared_terms.add(slug)
        for m in TYPST_LINK_RE.finditer(line):
            idx.link_dests.append(m.group(1))
        for m in TYPST_TERM_CITE_RE.finditer(line):
            idx.term_cites.append((lineno, m.group(1)))
        for m in TYPST_CTX_CITE_RE.finditer(line):
            idx.ctx_cites.append((lineno, m.group(1)))

    # The section index is the one index built off the JOINED source, because a
    # section call spans lines and its slug needs no line number. The comment-
    # stripped lines are joined rather than the raw ones, so a commented-out
    # section is no more an anchor here than it is anywhere else.
    for m in TYPST_SECTION_RE.finditer("\n".join(idx.stripped)):
        slug = section_slug(m.group(1))
        if slug:
            idx.section_ids.add(slug)

    return idx


def check_adr_calls(files: list, adr_numbers: set, report: Report) -> None:
    """Every #adr(N) names an ADR that exists on disk.

    This is the Typst counterpart of the markdown side's link resolution. The
    number IS the whole citation, so an ADR that was never written — or a digit
    typed wrong — is caught at the citing line, rather than surfacing later as
    a dead link inside a rendered document nobody re-reads.
    """
    for idx in files:
        for lineno, number in sorted(set(idx.adr_calls)):
            report.matched("ADR citations")
            if number not in adr_numbers:
                report.violation(
                    f"{idx.rel}:{lineno}",
                    "dangling ADR citation",
                    f"cites adr({number}), and the ADR directory holds no ADR "
                    f"with that number",
                )


def check_typst_cites(
    files: list, declared_terms: set, declared_contexts: set, report: Report
) -> None:
    """Every #term("…") and #ctx("…") names something the layer declares.

    THE MARKDOWN SIDE GOT THIS FOR FREE and the Typst side did not. A markdown
    citation is a LINK, so it carries a path the marker list recognises and
    check 1 resolves it. A Typst citation is a CALL carrying a bare name, which
    matches no marker, and the marker list held no `.typ` entry — so every one
    of them fell out of check 1 through the `continue` that drops a
    non-design-ish destination. Measured on a real layer: 91 ADR citations were
    enforced while 433 term and 46 context citations were not checked at all,
    and an invented slug passed the full gate green.

    The renderer now resolves these at compile time, which is the stronger
    check. This one is still worth running: it names EVERY offender with its
    file and line in one pass, where the compile stops at the first.
    """
    for idx in files:
        for lineno, slug in idx.term_cites:
            report.matched("term citations")
            if slug not in declared_terms:
                report.violation(
                    f"{idx.rel}:{lineno}",
                    "dangling term citation",
                    f'cites term("{slug}"), and no CONTEXT declares that slug',
                )
        for lineno, name in idx.ctx_cites:
            report.matched("context citations")
            if name not in declared_contexts:
                report.violation(
                    f"{idx.rel}:{lineno}",
                    "dangling context citation",
                    f'cites ctx("{name}"), and the layer holds no such context',
                )


def strip_anchors(pattern: str) -> str:
    """A schema id pattern is anchored (^...$); de-anchor it to search inside
    a longer string, exactly as the previous extract_by_pattern helper did."""
    return pattern.lstrip("^").rstrip("$")


def index_html(path: str, rel: str) -> FileIndex:
    """An .html target is indexed for its id="..." attributes only — that is
    the sole question check 1 asks of one."""
    idx = FileIndex(path=path, rel=rel, base=os.path.basename(path))
    text = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        pass
    idx.html_ids = set(re.findall(r'id="([^"]*)"', text))
    return idx


# --- Path helpers -------------------------------------------------------------


def clean_dest(raw: str) -> str:
    """Strip <>-wrapping, a trailing "title", and surrounding whitespace."""
    d = raw.strip()
    if d.startswith("<"):
        d = d[1:]
    if d.endswith(">"):
        d = d[:-1]
    marker = ' "'
    if marker in d:
        d = d.split(marker, 1)[0]
    return d


IGNORED_PREFIXES = ("#", "http://", "https://", "mailto:")


def is_ignorable(dest: str) -> bool:
    return dest == "" or dest.startswith(IGNORED_PREFIXES)


# --- Discovery ----------------------------------------------------------------


@dataclass
class Discovery:
    """Every layer file the gate found, already indexed."""

    design_docs: list
    contexts: list
    design_htmls: list
    map_files: list
    coverage_files: list
    adr_files: list
    map_present: bool
    adr_dir_present: bool


class Repo:
    """The target repo: its root, its git-awareness, and gitignore pruning."""

    def __init__(self, root: str) -> None:
        self.root = root
        self.is_git = (
            subprocess.run(
                ["git", "-C", root, "rev-parse", "--git-dir"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode
            == 0
        )

    def rel_of(self, path: str) -> str:
        prefix = self.root + "/"
        return path[len(prefix) :] if path.startswith(prefix) else path

    def prune_ignored(self, paths: list) -> list:
        """Drop gitignored paths. One batch `git check-ignore --stdin` per
        call; a non-git root is never pruned."""
        if not paths or not self.is_git:
            return paths
        proc = subprocess.run(
            ["git", "-C", self.root, "check-ignore", "--stdin"],
            input="\n".join(paths) + "\n",
            capture_output=True,
            text=True,
        )
        ignored = set(proc.stdout.splitlines())
        if not ignored:
            return paths
        return [p for p in paths if p not in ignored]

    def is_ignored(self, path: str) -> bool:
        if not self.is_git:
            return False
        return (
            subprocess.run(
                ["git", "-C", self.root, "check-ignore", "-q", path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode
            == 0
        )


def walk_layer_files(repo: Repo, names: set) -> dict:
    """One filesystem walk collecting every wanted basename. Dot-dirs and
    node_modules are pruned; gitignored paths are pruned in one batch."""
    found = {name: [] for name in names}
    for dirpath, dirnames, filenames in os.walk(repo.root):
        dirnames[:] = [
            d for d in dirnames if not d.startswith(".") and d != "node_modules"
        ]
        for fname in filenames:
            if fname in found:
                found[fname].append(os.path.join(dirpath, fname))
    everything = sorted({p for group in found.values() for p in group})
    kept = set(repo.prune_ignored(everything))
    return {
        name: sorted(p for p in paths if p in kept) for name, paths in found.items()
    }


# --- Check 1: link resolution, fail-closed ------------------------------------
#
# A link is design-ish when it matches any schema design_ish_marker (e.g.
# CONTEXT.md / design.md / design.pdf by basename, #term- / .md#adr- by
# substring, the ADR dir by resolved path). External URLs, pure # fragments,
# and non-design-ish relative links are ignored. For a design-ish link the
# file must exist AND any fragment must be a valid, present term or adr
# anchor — anything else (missing slug, #trem- typo, malformed adr id) is a
# violation, never a skip.


class TargetIndexes:
    """Lazily-built indexes of link TARGETS, keyed by absolute path.

    A target is read at most once no matter how many links point into it, so
    the cost grows with the layer, not with the square of the link graph.
    """

    def __init__(self, repo: Repo, schema: Schema, prebuilt: dict) -> None:
        self.repo = repo
        self.schema = schema
        self.cache = dict(prebuilt)

    def get(self, abspath: str) -> FileIndex:
        hit = self.cache.get(abspath)
        if hit is not None:
            return hit
        rel = self.repo.rel_of(abspath)
        if abspath.endswith(".html"):
            built = index_html(abspath, rel)
        else:
            built = index_markdown(abspath, rel, self.schema)
        self.cache[abspath] = built
        return built


def classify_designish(
    dest: str, base: str, abspath: str, repo: Repo, m: DesignIshMarkers
):
    """Return (designish, designish_re, in_marker_dir) for one destination."""
    designish = base in m.basenames or any(s in dest for s in m.substrings)
    designish_re = any(r.search(dest) for r in m.regexes)
    in_marker_dir = any(
        abspath.startswith(os.path.join(repo.root, d) + "/") for d in m.dirs
    )
    return designish, designish_re, in_marker_dir


def check_links(
    src: FileIndex, repo: Repo, schema: Schema, targets: TargetIndexes, report: Report
) -> None:
    rel = src.rel
    src_dir = os.path.dirname(src.path)
    for raw in src.link_dests + src.click_dests:
        dest = clean_dest(raw)
        if is_ignorable(dest):
            continue
        filepart, _, frag = dest.partition("#")
        if not filepart:
            continue  # pure fragment
        base = filepart.rsplit("/", 1)[-1]

        if filepart.startswith("/"):
            abspath = os.path.normpath(os.path.join(repo.root, filepart[1:]))
        else:
            abspath = os.path.normpath(os.path.join(src_dir, filepart))

        designish, designish_re, in_marker_dir = classify_designish(
            dest, base, abspath, repo, schema.markers
        )
        if not (designish or designish_re or in_marker_dir):
            continue  # matches no schema marker — not design-ish
        report.matched("links resolved")

        if not frag:
            if not os.path.exists(abspath):
                report.violation(rel, "dangling link", f"target not found: {dest}")
            elif designish_re and not designish and not in_marker_dir:
                # Classified adr-ish by filename shape alone, yet the target
                # lives outside every schema directory marker: a stray adr-ish
                # file, not a canonical ADR. (Inside the ADR dir, check 2 owns
                # lockstep.)
                report.violation(
                    rel,
                    "stray adr-ish file",
                    f"{dest} matches an adr-ish schema marker but resolves "
                    f"outside {schema.adr_dir_rel}/",
                )
            continue

        if not os.path.isfile(abspath):
            report.violation(rel, "dangling link", f"target file not found: {dest}")
            continue

        if schema.term_id_re.search(frag):
            kind = "term"
        elif schema.adr_id_re.search(frag):
            kind = "adr"
        elif schema.section_id_re is not None and schema.section_id_re.search(frag):
            # A pointer into a SECTION of a design document — the form
            # design_doc.generation.link_rewrite documents. Accepted alongside
            # term and adr so the schema and this gate agree; before it was
            # declared, the one blessed form for cross-document section
            # pointers was the one the gate rejected.
            kind = "section"
        else:
            report.violation(
                rel,
                "malformed anchor",
                f"design-ish fragment '#{frag}' in {dest} matches neither the "
                "term, adr, nor section id pattern",
            )
            continue

        target = targets.get(abspath)
        if abspath.endswith(".html"):
            if frag not in target.html_ids:
                report.violation(
                    rel, f"dangling {kind} anchor", f'no id "{frag}" in {filepart}'
                )
        elif kind == "term":
            if frag not in target.declared_terms:
                report.violation(
                    rel,
                    "dangling term anchor",
                    f'{filepart} declares no term with slug "{frag}"',
                )
        elif kind == "section":
            if frag not in target.section_ids:
                report.violation(
                    rel,
                    "dangling section anchor",
                    f'no heading renders id "{frag}" in {filepart}',
                )
        else:
            if frag not in target.adr_anchor_frags:
                report.violation(
                    rel,
                    "dangling adr anchor",
                    f'no <a id="{frag}"></a> in {filepart}',
                )


# --- Check 2: ADR lockstep ----------------------------------------------------


def check_adrs(adr_files: list, schema: Schema, report: Report) -> None:
    for idx in adr_files:
        fname_ok = True
        if not schema.adr_file_re.search(idx.base):
            report.violation(
                idx.rel,
                "bad adr filename",
                f"does not match schema filename pattern {schema.adr_file_src}",
            )
            fname_ok = False

        # Anchor elements are exactly the lines matching the schema element
        # regex. Anchor-ish lines that do NOT match it are near-misses — fail
        # closed.
        elements = idx.adr_elements
        ecount = len(elements)
        if idx.loose_anchor_count > ecount:
            report.violation(
                idx.rel,
                "malformed adr anchor",
                f"{idx.loose_anchor_count - ecount} anchor-ish line(s) do not "
                f"match the schema element regex {schema.adr_element_src}",
            )
            continue
        if ecount == 0:
            report.violation(
                idx.rel,
                "missing adr anchor",
                "no anchor element matching the schema element regex "
                f"{schema.adr_element_src}",
            )
            continue
        if ecount != 1:
            report.violation(
                idx.rel,
                "multiple adr anchors",
                f"expected exactly one anchor element, found {ecount}",
            )
            continue

        joined = "\n".join(elements)
        m = re.search(strip_anchors(schema.adr_id_src), joined)
        if not m:
            report.violation(
                idx.rel,
                "malformed adr anchor",
                f"cannot extract an id matching {schema.adr_id_src} from "
                f"anchor element: {joined}",
            )
            continue
        if fname_ok:
            nnnn_file = idx.base.split("-", 1)[0]
            nnnn_anchor = (
                m.group(0)[len("adr-") :]
                if m.group(0).startswith("adr-")
                else m.group(0)
            )
            if nnnn_file != nnnn_anchor:
                report.violation(
                    idx.rel,
                    "adr lockstep mismatch",
                    f"filename NNNN '{nnnn_file}' != anchor NNNN '{nnnn_anchor}'",
                )


# --- Check 3: term anchor validity in CONTEXT.typ -----------------------------


def check_terms(contexts: list, schema: Schema, report: Report) -> None:
    for idx in contexts:
        seen = set()
        for term_id in idx.term_anchor_ids:
            if not term_id:
                report.violation(
                    idx.rel, "invalid term anchor", 'slug: "" has no id at all'
                )
                continue
            if not schema.term_id_re.search(term_id):
                report.violation(
                    idx.rel,
                    "invalid term anchor",
                    f'slug: "{term_id}" does not match schema term id '
                    f"pattern {schema.term_id_src}",
                )
            if term_id in seen:
                report.violation(
                    idx.rel,
                    "duplicate term id",
                    f'slug: "{term_id}" declared more than once',
                )
            else:
                seen.add(term_id)


# --- Check 4: map totality (multi-context) ------------------------------------


def linked_paths(src: FileIndex, base_dir: str, repo: Repo, wanted: set) -> set:
    """The set of absolute paths this file links, restricted to the wanted
    basenames. Fragments are dropped — the map's contract is the exact path."""
    out = set()
    for raw in src.link_dests:
        dest = clean_dest(raw)
        if is_ignorable(dest):
            continue
        dest = dest.split("#", 1)[0]
        if not dest:
            continue
        if dest.rsplit("/", 1)[-1] not in wanted:
            continue
        if dest.startswith("/"):
            out.add(os.path.normpath(os.path.join(repo.root, dest[1:])))
        else:
            out.add(os.path.normpath(os.path.join(base_dir, dest)))
    return out


def check_map_totality(
    disc: Discovery,
    repo: Repo,
    schema: Schema,
    map_index: Optional[FileIndex],
    root_design_index: Optional[FileIndex],
    domain_design: list,
    report: Report,
) -> None:
    n = len(disc.contexts)
    if n < 2:
        return  # single-context: CONTEXT-MAP.md is not required

    if not disc.map_present:
        report.violation(
            schema.map_rel,
            "missing context map",
            f"{n} glossary file(s) exist but {schema.map_rel} is absent at its "
            "declared home",
        )
    else:
        # The map links each context's GLOSSARY by path, and the basename it
        # links depends on the layer's notation. A Typst layer's glossary is
        # CONTEXT.typ, so demanding a CONTEXT.md link would report every
        # context as unmapped against a map that indexes all of them.
        wanted = {"CONTEXT.md", "CONTEXT.typ"}
        map_refs = linked_paths(
            map_index, os.path.dirname(map_index.path), repo, wanted
        )
        for ctx in disc.contexts:
            if ctx.path not in map_refs:
                report.violation(
                    schema.map_rel,
                    "unmapped glossary",
                    f"{ctx.rel} has no exact link in the map",
                )

    if not domain_design:
        return
    if root_design_index is None:
        report.violation(
            schema.root_design_rel,
            "missing root design doc",
            "domain design docs exist but the root design doc is absent",
        )
        return

    # THE ROOT INDEXES EVERY CONTEXT, and the reference is a CALL rather than a
    # path: `#ctx("lifecycle")` names the context the root is indexing. So the
    # question "is any domain design document orphaned from the root" is asked
    # against the root's ctx() arguments, not against its link destinations.
    #
    # This check used to be asked only of a markdown root, and returned early on
    # anything else. Once markdown authoring was removed that early return was
    # unconditional, so the check examined nothing while still reading as
    # enforcement. The invariant is unchanged — no context is unreachable from
    # the root — and only the vocabulary it is asked in has moved.
    #
    # The other direction, a root naming a context that does not exist, is
    # check_typst_cites's job against declared_contexts. The two together are
    # the bidirectional totality the path form used to give.
    root_named = {name for _lineno, name in root_design_index.ctx_cites}
    for doc in domain_design:
        ctx_name = os.path.basename(os.path.dirname(doc.path))
        report.matched("root context index")
        if ctx_name not in root_named:
            report.violation(
                doc.rel,
                "unindexed domain design doc",
                f'not named by any ctx("…") call in {schema.root_design_rel}',
            )


# --- Check 5: retired ---------------------------------------------------------
#
# This slot held "every design.pdf sits beside the design.md it was rendered
# from". That pairing was the contract when each context rendered its own PDF.
# The layer now renders as ONE document, so the sibling pairing it asserted is
# exactly the arrangement that must NOT exist, and check 8 (homing) already
# rejects a design.pdf anywhere but the layer's rendered document — a strictly
# stronger statement, since it catches a stray beside its source too. The
# number is kept rather than reused so the other checks keep their identities.


# --- Check 6: no verbatim-duplicate non-trivial lines -------------------------
#
# Within one design.typ or CONTEXT.typ, a non-trivial run of PROSE appearing
# verbatim more than once means a fact lives in two places (restatement instead
# of a cross-link). Scope is within one file, never across files.
#
# THE UNIT IS PROSE, NOT THE SOURCE LINE, and that is the whole design of this
# check. Under a call notation a repeated line is usually the syntax working:
# an entity census writes `#attribute(provenance: "authored")[` once per
# attribute, and a set of state machines opens each with the same node. Counting
# lines would fail every well-formed layer, which trains a reader to ignore the
# check and hides the restatement it exists to catch. So the call scaffolding is
# stripped first and only what a reader actually reads is counted.

WORD_RE = re.compile(r"[^\W\d_]{2,}", re.ASCII)
# A citation is a call carrying a bare name — term("x"), ctx("y"), adr(12).
# Repeating one is the LEGAL form of repetition: citing, never restating.
CITE_CALL_RE = re.compile(r"#?\b(?:term|ctx|adr|lens-pill|chip)\s*\([^)]*\)")
# The same citation, written through Typst's code-block form so the helper is
# imported at the citing site: `#{ import "../refs.typ": adr; adr(63) }`. The
# WHOLE wrapper is one citation and is removed as one.
#
# Removing only the inner `adr(63)` — which is what the citation pattern above
# did on its own — left the import preamble behind as the entire surviving
# "prose". Two citations of DIFFERENT decisions then normalized to the identical
# string `#{ import "../refs.typ": adr; } .`, and the duplicate check reported
# restatement over two lines that restate nothing. The boilerplate carries no
# prose in the first place, so it belongs with the citation it wraps rather than
# in the text a reader is held to.
CITE_BLOCK_RE = re.compile(
    r"#\{\s*import\s+\"[^\"]*\"\s*:[^;]*;\s*"
    r"(?:term|ctx|adr|lens-pill|chip)\s*\([^)]*\)\s*\}"
)
# The call scaffolding on a line: a leading `#name(`, named arguments up to
# their value, and the brackets that open or close a content block. What
# survives is the text a reader sees.
CALL_HEAD_RE = re.compile(r"#[a-z][a-z0-9-]*\s*\(")
NAMED_ARG_RE = re.compile(r"\b[a-z][a-z0-9-]*\s*:\s*")
SCAFFOLD_RE = re.compile(r"[\[\]()<>,]+")


def prose_of(line: str) -> str:
    """The prose a source line carries, with the call scaffolding removed.

    Returns "" when the line carries no prose — a bare call head, a closing
    bracket, an argument list of enum values. Such a line is exempt: it repeats
    because the notation makes it repeat.
    """
    t = line.strip()
    if not t:
        return ""
    # A citation-only fragment is the legal repetition, so it is removed before
    # anything is counted rather than counted and then excused. The wrapped form
    # goes first, so the whole `#{ import …; adr(N) }` is taken as one citation
    # rather than having its inner call removed and its preamble left standing.
    t = CITE_BLOCK_RE.sub(" ", t)
    t = CITE_CALL_RE.sub(" ", t)
    t = CALL_HEAD_RE.sub(" ", t)
    t = NAMED_ARG_RE.sub(" ", t)
    t = SCAFFOLD_RE.sub(" ", t)
    t = re.sub(r"\s+", " ", t).strip()
    if not WORD_RE.search(t):
        return ""
    # Too short to be a copy-pasted claim. The floor is the same one the line
    # form used: below it, a repeat is a coincidence of phrasing.
    if len(t) < 24:
        return ""
    return t


def check_duplicate_lines(docs: list, report: Report) -> None:
    for idx in docs:
        counts = {}
        order = []
        for line in idx.stripped:
            t = prose_of(line)
            if not t:
                continue
            if t in counts:
                counts[t] += 1
            else:
                counts[t] = 1
                order.append(t)
        for t in order:
            report.matched("prose runs")
            if counts[t] > 1:
                report.violation(
                    idx.rel,
                    "duplicate prose",
                    f"'{t}' appears {counts[t]}x",
                )


# --- Check 7: no generation debris --------------------------------------------
#
# A generation-wrapper artifact line inside a layer artifact means the writer
# leaked its transport envelope into durable content. The line shapes are the
# schema's layer_layout.generation_debris_patterns; the artifact set is every
# design.md, CONTEXT.md, CONTEXT-MAP.md, COVERAGE.md, and ADR file. Fenced code
# blocks are exempt: an example of the wrapper is documentation, not leakage.


def check_debris(files: list, schema: Schema, report: Report) -> None:
    for idx in files:
        for pattern, src in schema.debris:
            for line in idx.stripped:
                if not pattern.search(line):
                    continue
                if not line:
                    continue
                report.violation(
                    idx.rel,
                    "generation debris",
                    f"'{line.strip()}' is a generation-wrapper artifact line "
                    f"(schema pattern {src}) — writer leakage, not layer content",
                )


# --- Check 8: layer homing ----------------------------------------------------
#
# The design layer lives entirely under docs/ (schema layer_layout.homing):
# every layer basename has one or more declared homes, and a layer file found
# anywhere else is a mishomed stray — the layout contract is validated on every
# run, never assumed. A '<context>' placeholder in a home matches exactly one
# path segment shaped by homing.context_segment.


def is_homed(rel: str, base: str, schema: Schema) -> bool:
    for home in schema.homes.get(base, []):
        if "<context>" in home:
            pre, post = home.split("<context>")
            if (
                rel.startswith(pre)
                and rel.endswith(post)
                and len(rel) > len(pre) + len(post)
            ):
                mid = rel[len(pre) : len(rel) - len(post)]
                if "/" not in mid and schema.context_segment_re.search(mid):
                    return True
        elif rel == home:
            return True
    return False


def check_homing(files: list, schema: Schema, report: Report) -> None:
    for idx in files:
        if not is_homed(idx.rel, idx.base, schema):
            homes = " or ".join(schema.homes.get(idx.base, []))
            report.violation(
                idx.rel,
                "mishomed layer artifact",
                f"{idx.base} must live at {homes} (schema layer_layout.homing)",
            )


# --- Staleness advisory (schema layer_layout.staleness_advisory) --------------
#
# Advisory only — exit codes untouched. When the repo has moved threshold+
# commits since any layer artifact last changed, print one line recommending
# reconcile (sync). Skipped outside git, when the layer was never committed, or
# when the schema copy predates the key (tolerate-absent).


def staleness_advisory(repo: Repo, schema: Schema, files: list) -> None:
    if schema.staleness_threshold is None:
        return
    if not repo.is_git or not files:
        return
    paths = [idx.path for idx in files]
    last = subprocess.run(
        ["git", "-C", repo.root, "log", "-1", "--format=%H", "--"] + paths,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if not last:
        return
    proc = subprocess.run(
        ["git", "-C", repo.root, "rev-list", "--count", f"{last}..HEAD"],
        capture_output=True,
        text=True,
    )
    try:
        count = int(proc.stdout.strip()) if proc.returncode == 0 else 0
    except ValueError:
        count = 0
    if count >= schema.staleness_threshold:
        print(
            f"advisory: {count} commit(s) since the design layer last changed "
            f"(threshold {schema.staleness_threshold}) — reconcile (sync) "
            "before relying on the layer"
        )


# --- Decision-citation advisory (schema decision_citation_advisory) -----------
#
# Advisory only — exit codes untouched. Every other check here is REFERENTIAL:
# it proves a citation RESOLVES. That makes the whole gate blind in one
# direction, because a citation that was never written resolves vacuously — a
# layer citing 12 decisions passes exactly as green as one citing 123.
#
# The blindness is measured rather than supposed. A re-derivation of this
# framework's own layer kept all 72 ADRs on disk, cited 10 of them, and passed
# the full gate: the rationale sat there untouched and nothing said so. This is
# the one signal that reads the UNCITED side.
#
# A decision a later one supersedes is legitimately dormant, so it is excluded.
# The ledger records supersession only on the CITING side — a successor names
# its predecessor in prose, and no ADR carries a status field saying it is dead
# — so the relation is derived from the successors rather than read off the
# superseded file.
#
# It stays an advisory because the right number of uncited decisions is not
# zero and cannot be declared: a decision may be genuinely dormant without a
# successor. What the reader needs is the COUNT, visible without diffing
# against a layer they no longer have.


def decision_citation_advisory(
    adr_numbers: set, adr_files: list, cited: set, schema: Schema
) -> None:
    if schema.supersession_res is None or not adr_numbers:
        return

    superseded = set()
    for idx in adr_files:
        try:
            body = open(idx.path, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for rx in schema.supersession_res:
            superseded.update(int(m.group(1)) for m in rx.finditer(body))

    dormant = sorted(adr_numbers - cited - superseded)
    if not dormant:
        return

    # NAME EXAMPLES, never the whole list. The count is the signal; a hundred
    # numbers printed at a commit is noise the reader learns to scroll past.
    shown = ", ".join(f"ADR-{n:04d}" for n in dormant[:5])
    more = f" (+{len(dormant) - 5} more)" if len(dormant) > 5 else ""
    print(
        f"advisory: {len(dormant)} of {len(adr_numbers)} decision(s) are cited "
        f"by no design document — {shown}{more}. A decision no section cites "
        "is rationale the layer no longer carries; cite it from the section it "
        "governs, or supersede it."
    )


# --- Main ---------------------------------------------------------------------


def main(argv: list) -> int:
    args = argv[1:]
    if len(args) > 1:
        print(f"usage: {os.path.basename(argv[0])} [repo-root]", file=sys.stderr)
        return 2
    repo_arg = args[0] if args else "."
    if not os.path.isdir(repo_arg):
        print(f"error: repo root not found: {repo_arg}", file=sys.stderr)
        return 2
    root = os.path.realpath(repo_arg)

    schema = load_schema(locate_schema(argv[0]))
    repo = Repo(root)
    report = Report()

    # --- Discovery: one walk, one batch gitignore prune.
    layer_names = {
        # The authoring surface.
        "design.typ",
        "CONTEXT.typ",
        # The RETIRED authoring surface, walked but never checked. Markdown
        # authoring was removed, and a layer still holding these files is
        # refused by name below. Dropping them from the walk instead would
        # report "no design layer" against a directory visibly full of design
        # documents, sending the reader after the wrong fault.
        "design.md",
        "CONTEXT.md",
        # Both names are walked: design-layer.pdf is the layer's rendered
        # document, and design.pdf is walked ONLY so a per-context render left
        # by an older framework version is discovered and reported as the
        # mishomed stray it now is, rather than sitting unseen.
        "design.pdf",
        "design-layer.pdf",
        "CONTEXT-MAP.md",
        "COVERAGE.md",
    }
    walked = walk_layer_files(repo, layer_names)

    map_abs = os.path.join(root, schema.map_rel)
    adr_dir = os.path.join(root, schema.adr_dir_rel)
    root_design_abs = os.path.join(root, schema.root_design_rel)

    map_present = os.path.isfile(map_abs) and not repo.is_ignored(map_abs)
    adr_dir_present = os.path.isdir(adr_dir) and not repo.is_ignored(adr_dir)

    adr_paths = []
    if adr_dir_present:
        entries = [
            os.path.join(adr_dir, name)
            for name in os.listdir(adr_dir)
            if not name.startswith(".") and os.path.isfile(os.path.join(adr_dir, name))
        ]
        adr_paths = sorted(repo.prune_ignored(sorted(entries)))

    if (
        not walked["design.md"]
        and not walked["CONTEXT.md"]
        and not walked["design.typ"]
        and not walked["CONTEXT.typ"]
        and not walked["design.pdf"]
        and not walked["design-layer.pdf"]
        and not map_present
        and not adr_dir_present
    ):
        print(
            f"error: no design layer in {root} (no design.typ, CONTEXT.typ, "
            f"{schema.map_rel}, {schema.adr_dir_rel}/, or a rendered document)",
            file=sys.stderr,
        )
        return 2

    # A LEGACY MARKDOWN LAYER IS REFUSED, never checked. Markdown authoring was
    # removed, so every check below reads a notation these files are not in:
    # the indexer would find zero terms, zero citations and zero sections, and
    # each check would report clean over an empty set. That is the vacuity this
    # gate's own anti-vacuity guard exists to prevent, so the condition is
    # caught here, where it can be named, rather than downstream where it reads
    # as a passing layer.
    if walked["design.md"] or walked["CONTEXT.md"]:
        print(
            f"error: the layer in {root} is authored in Markdown, and the "
            f"framework now authors Typst",
            file=sys.stderr,
        )
        for p in walked["design.md"] + walked["CONTEXT.md"]:
            print(f"  markdown: {repo.rel_of(p)}", file=sys.stderr)
        print(
            "  Markdown authoring was removed: a design document is a "
            "design.typ calling the library directly, and its glossary a "
            "CONTEXT.typ. See migration 0008.",
            file=sys.stderr,
        )
        return 2

    # --- The one read: every discovered layer file is indexed exactly once.
    # The markdown artifacts: the map, the coverage table, and the ADRs. These
    # were never the authoring surface and stay markdown, so they keep the
    # markdown indexer. An .html LINK TARGET is still read by index_html, but
    # through TargetIndexes rather than here — no layer artifact is authored as
    # html, so there is nothing to walk.
    def index_all(paths: list) -> list:
        return [index_markdown(p, repo.rel_of(p), schema) for p in paths]

    def index_all_typst(paths: list) -> list:
        return [index_typst(p, repo.rel_of(p), schema) for p in paths]

    design_docs = index_all_typst(walked["design.typ"])
    contexts = index_all_typst(walked["CONTEXT.typ"])
    design_pdfs = [
        FileIndex(path=p, rel=os.path.relpath(p, repo.root), base=os.path.basename(p))
        for p in walked["design.pdf"] + walked["design-layer.pdf"]
    ]
    map_files = index_all(walked["CONTEXT-MAP.md"])
    coverage_files = index_all(walked["COVERAGE.md"])
    adr_files = index_all(adr_paths)

    # An ADR's anchor fragments come from its already-parsed anchor elements;
    # a link into it is answered from this set, never by rereading the file.
    for idx in adr_files + design_docs + contexts + map_files + coverage_files:
        for line in idx.adr_elements:
            m = re.search(strip_anchors(schema.adr_id_src), line)
            if m:
                idx.adr_anchor_frags.add(m.group(0))

    by_path = {
        idx.path: idx
        for idx in design_docs
        + contexts
        + design_pdfs
        + map_files
        + coverage_files
        + adr_files
    }
    targets = TargetIndexes(repo, schema, by_path)

    root_design_index = by_path.get(root_design_abs)
    domain_design = [d for d in design_docs if d.path != root_design_abs]
    map_index = by_path.get(map_abs) if map_present else None
    if map_present and map_index is None:
        map_index = index_markdown(map_abs, repo.rel_of(map_abs), schema)
        by_path[map_abs] = map_index
        targets.cache[map_abs] = map_index

    # --- The eight checks, each a lookup against the indexes above.
    for src in design_docs:
        check_links(src, repo, schema, targets, report)
    if map_index is not None:
        check_links(map_index, repo, schema, targets, report)
    # The coverage map cites terms and design sections like any other entry
    # point, so its links resolve under the same rules. Without this it was the
    # one layer artifact whose citations were indexed but never resolved: an
    # invented term anchor passed clean here while the identical break inside a
    # design document failed, which is exactly the silent hole the map is
    # supposed to close.
    for cov in coverage_files:
        check_links(cov, repo, schema, targets, report)

    check_adrs(adr_files, schema, report)
    check_terms(contexts, schema, report)

    # The Typst side's ADR citation is a NUMBER, so it is resolved against the
    # ADR filenames on disk. The number set comes from the filenames rather
    # than the anchors, because the filename is what a link opens; check_adrs
    # separately holds the two in lockstep.
    adr_numbers = set()
    for idx in adr_files:
        m = re.match(r"^(\d+)-", idx.base)
        if m:
            adr_numbers.add(int(m.group(1)))
    check_adr_calls(design_docs + contexts, adr_numbers, report)

    # A term citation resolves against the slugs the CONTEXTs declare, and a
    # context citation against the context directories the layer holds.
    declared_terms = set()
    for idx in contexts:
        declared_terms.update(idx.declared_terms)
    declared_contexts = {
        os.path.basename(os.path.dirname(idx.path)) for idx in contexts
    }
    check_typst_cites(design_docs + contexts, declared_terms, declared_contexts, report)

    # ANTI-VACUITY, asserted where zero is genuinely impossible and nowhere
    # else. A check reports the same clean line over an empty set as over a
    # full one, so the count must be visible — but a floor is only honest
    # where the layer cannot legitimately be empty. A small layer may cite no
    # term at all, so "zero citations" is not by itself a defect.
    #
    # What IS impossible is a layer whose files carry citations that the scan
    # then resolves none of. The comparison is against the raw text, so a
    # pattern that stops matching is caught by the thing it stopped matching.
    cite_bearing = 0
    for idx in design_docs + contexts:
        if not idx.path.endswith(".typ"):
            continue
        for line in idx.stripped:
            cite_bearing += line.count("#term(") + line.count("#ctx(")
    if cite_bearing:
        resolved = report.counts.get("term citations", 0) + report.counts.get(
            "context citations", 0
        )
        if not resolved:
            report.violation(
                "layer-integrity",
                "vacuous citation check",
                f"the layer's Typst sources hold {cite_bearing} term()/ctx() "
                "citation(s) and the scan resolved none, so the check "
                "examined nothing while reporting clean",
            )

    disc = Discovery(
        design_docs=design_docs,
        contexts=contexts,
        design_htmls=design_pdfs,
        map_files=map_files,
        coverage_files=coverage_files,
        adr_files=adr_files,
        map_present=map_present,
        adr_dir_present=adr_dir_present,
    )
    check_map_totality(
        disc, repo, schema, map_index, root_design_index, domain_design, report
    )
    check_duplicate_lines(design_docs + contexts, report)
    check_debris(
        design_docs + contexts + map_files + coverage_files + adr_files, schema, report
    )
    check_homing(
        design_docs + design_pdfs + contexts + map_files + coverage_files,
        schema,
        report,
    )

    staleness_advisory(
        repo,
        schema,
        design_docs + contexts + map_files + coverage_files + adr_files,
    )

    # The cited set comes from the SAME adr_calls check_adr_calls resolves, so
    # the advisory and the check can never disagree about what was cited.
    decision_citation_advisory(
        adr_numbers,
        adr_files,
        {n for idx in design_docs + contexts for _, n in idx.adr_calls},
        schema,
    )

    if report.found:
        return 1
    # THE SUMMARY REPORTS WHAT WAS CHECKED, not what was discovered. The old
    # line counted files found and named them `CONTEXT.md` — against a Typst
    # layer holding zero `.md` files it printed "5 CONTEXT.md", which reads as
    # five files checked and was neither the right count's subject nor an
    # assertion count at all. A discovery number cannot distinguish a check
    # that resolved seven hundred references from one that resolved none, and
    # that is the difference this line exists to show.
    resolved = ", ".join(
        f"{n} {what}" for what, n in sorted(report.counts.items()) if n
    )
    print(
        f"layer-integrity OK: {len(design_docs)} design doc(s), "
        f"{len(contexts)} glossary file(s), {len(adr_files)} ADR(s) in {root}"
        + (f" — resolved {resolved}" if resolved else "")
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
