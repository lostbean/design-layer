#!/usr/bin/env python3
"""md-to-typst — the fence router.

Reads an authored `design.md` and emits the Typst that calls the projected
block-contract library. The authored artifact stays Markdown: this is what
keeps a design document reviewable in a diff, renderable on a forge, and
portable across a renderer change — the property that let the authored files
survive the last renderer swap untouched.

Usage:
  md-to-typst <design.md> <out.typ> [--lib <path-to-designlib.typ>]

WHY THE ESCAPING IS STRUCTURED THIS WAY, and not as escape-then-unescape.

Typst reserves `#`, `$`, `@` in content position. Authored prose contains all
three — this framework's own layer carries 536 inline `#term-` references. The
obvious approach, escaping the whole line and then un-escaping the calls the
router emitted, was tried and produced four distinct silent-corruption bugs:
a mangled em dash, a swallowed `;`, a leaked `\\#box[`, and an authored
`#term-` rendered as `\\#term-`. Every one shipped a document that compiled
cleanly and said something different from what the author wrote.

So the router never escapes text it has already converted. It splits each line
into SPANS — literal prose, and emitted Typst — converts prose spans once, and
concatenates. Emitted spans are never re-examined, so nothing the router wrote
can be corrupted by a later pass, and a new emitter cannot rot a
hand-maintained un-escape list.

Raw spans (code) are held out entirely: their content is verbatim in Typst, so
an authored `#term-` inside backticks must NOT be escaped, and escaping it
would render the backslash.

Exit: 0 wrote the file, 2 on a read/parse error.
"""

import json
import os
import re
import sys

# ---------------------------------------------------------------------------
# spans: the router's central discipline
# ---------------------------------------------------------------------------
LIT, OUT = "lit", "out"          # literal prose | already-emitted Typst


def esc(s):
    """Escape a Typst string literal."""
    return s.replace("\\", "\\\\").replace('"', '\\"')


def esc_prose(s):
    """Escape the characters Typst reserves in CONTENT position.

    Applied only to literal prose spans, never to emitted Typst.
    """
    return s.replace("\\", "\\\\").replace("#", r"\#") \
            .replace("$", r"\$").replace("@", r"\@")


def _split(spans, pattern, emit):
    """Apply `pattern` to every LITERAL span, replacing matches with emitted
    Typst. Already-emitted spans pass through untouched."""
    out = []
    for kind, text in spans:
        if kind is OUT:
            out.append((kind, text))
            continue
        pos = 0
        for m in pattern.finditer(text):
            if m.start() > pos:
                out.append((LIT, text[pos:m.start()]))
            out.append((OUT, emit(m)))
            pos = m.end()
        if pos < len(text):
            out.append((LIT, text[pos:]))
    return out


# a raw HTML anchor — `<a id="adr-NNNN"></a>` — is how an ADR carries its
# anchor in markdown. Typst reads `<...>` as a label, so an unconverted anchor
# is a syntax error; it becomes a real Typst label instead.
HTML_ANCHOR_RE = re.compile(r'<a\s+id="([^"]+)"\s*>\s*</a>')
CODE_RE = re.compile(r"`([^`]+)`")
LINK_RE = re.compile(r"\[([^\]]+)\]\(([^)]+)\)")
BOLD_RE = re.compile(r"\*\*([^*]+)\*\*")
ITAL_RE = re.compile(r"(?<![*\w])\*([^*\n]+)\*(?!\*)")


def _emphasis(spans, pattern, mark):
    """Match emphasis across span boundaries without re-escaping what is done.

    _split only looks inside one LIT span, which is right for a pattern whose
    delimiters and content are all still raw markdown. Emphasis is different: by
    the time it runs the link and code splits have already emitted opaque spans,
    so `**[Term](dest)**` leaves its two `**` markers in SEPARATE LIT spans with
    an OUT span between them. _split can never pair them.

    The scan therefore runs over the joined text, but the REBUILD preserves the
    original span kinds: a matched region is re-emitted as the pieces it was
    made of, wrapped in the mark. Rebuilding it as one LIT string would send an
    already-converted `#lnk(...)` back through esc_prose and corrupt it into
    `\\#lnk(...)`.

    A match is kept only when both delimiters are LIT — an asterisk inside
    emitted output is literal text, not markup the author wrote.
    """
    joined = "".join(t for _k, t in spans)
    if not pattern.search(joined):
        return spans
    owner = []
    for kind, text in spans:
        owner.extend([kind] * len(text))

    def slice_spans(a, b):
        """The original spans covering [a, b), split at the boundaries."""
        out, pos = [], 0
        for kind, text in spans:
            lo, hi = pos, pos + len(text)
            pos = hi
            if hi <= a or lo >= b:
                continue
            out.append((kind, text[max(a, lo) - lo:min(b, hi) - lo]))
        return out

    result, last, matched = [], 0, False
    for m in pattern.finditer(joined):
        a, b = m.span()
        if owner[a] is not LIT or owner[b - 1] is not LIT:
            continue
        matched = True
        result.extend(slice_spans(last, a))
        result.append((OUT, mark))
        result.extend(slice_spans(*m.span(1)))
        result.append((OUT, mark))
        last = b
    if not matched:
        return spans
    result.extend(slice_spans(last, len(joined)))
    return result


def inline(s):
    """Convert one line of Markdown inline markup to Typst."""
    spans = [(LIT, s)]

    def code(m):
        body = m.group(1)
        # an inline `lens:x+y` code span renders as the lens pill
        if body.startswith("lens:"):
            names = [n for n in body[5:].split("+") if n]
            return "#pill(" + ", ".join('"%s"' % n for n in names) + ")"
        # raw content is VERBATIM in Typst: emit backtick raw, never #raw(),
        # because a call swallows a following `;` as a code terminator.
        return "`" + body.replace("`", "'") + "`"

    spans = _split(spans, HTML_ANCHOR_RE,
                   lambda m: "<%s>" % re.sub(r"[^\w-]", "-", m.group(1)))
    # A LINK IS SPLIT BEFORE A CODE SPAN, and its text is converted by a
    # recursive call. Order matters and the reverse order is a real bug that
    # shipped: when the code split ran first, the text of ``[`afk`](dest)`` was
    # already an emitted span, so LINK_RE could no longer match across it — the
    # link never became a #lnk call, and the page printed the literal markdown
    # `[afk](CONTEXT.md#term-run-mode)` with no clickable annotation. Seven
    # sites in this layer's own committed PDFs carried that corruption.
    #
    # Recursing on the link text (rather than escaping it as flat prose) is what
    # lets a code span, bold, or italic inside the text still convert. The
    # recursion terminates because LINK_RE cannot match inside its own text: a
    # nested `](` would have been consumed by the outer match.
    spans = _split(spans, LINK_RE,
                   lambda m: '#lnk("%s")[%s]' % (esc(m.group(2)),
                                                 inline(m.group(1))))
    spans = _split(spans, CODE_RE, code)
    # Emphasis is matched ACROSS already-emitted spans, not only within a
    # literal one. `**[Term](dest)**` — ordinary CommonMark, and the usual shape
    # of a table's first column — put the link in an opaque OUT span between the
    # two `**` markers, stranding each marker in a SEPARATE literal span where
    # BOLD_RE could never see them as a pair. esc_prose does not escape `*`, so
    # both reached Typst, which warned "no text within stars" on each.
    #
    # The link must still split FIRST (the ordering bug documented above), so
    # the fix is not a reorder: it is to re-join the spans and match emphasis
    # over the joined text, whose already-converted regions are opaque to the
    # emphasis pattern because they no longer contain markdown.
    spans = _emphasis(spans, BOLD_RE, "*")
    spans = _emphasis(spans, ITAL_RE, "_")
    return "".join(esc_prose(t) if k is LIT else t for k, t in spans)


# ---------------------------------------------------------------------------
# prose: the inline layer, parsed by cmarker rather than by regex
# ---------------------------------------------------------------------------
# The regex path (`inline`) below cannot see across a line break, so an inline
# span that WRAPS is never matched and its markers reach Typst raw. That was not
# one bug: 24 sites in this layer rendered with their emphasis silently dropped,
# and the compiler warned about every one on every build. So the inline layer of
# PROSE goes to cmarker, a real CommonMark parser already in the vendored set.
#
# PROSE CARRIES AS LITTLE RAW-TYPST AS POSSIBLE — one construct, and only when
# the paragraph actually contains it.
#
# An earlier note here claimed the reason was that a `<!--raw-typst -->` span
# anywhere in a paragraph makes cmarker escape every following `**`. THAT CLAIM
# IS WRONG and was retracted after re-testing it against cmarker 0.1.6 directly:
# bold pairs correctly after a raw span, before one, wrapping one, with two
# spans present, and in the router's own output for a lens pill. Nothing here
# rests on it.
#
# The real reason is narrower and still worth holding to. Every raw-typst span
# is text the CommonMark parser does not see as markdown, so it is a hole in
# the one component that knows the grammar — and holes are what the hand-written
# inline layer was made of. The reverted attempt injected a raw-typst call for
# EVERY link, which put a hole in nearly every paragraph; keeping links as
# ordinary markdown and resolving only their DESTINATION is what let the parser
# see whole sentences again.
#
# So the two constructs that must become Typst are handled WITHOUT injecting
# markup into the text where there is any alternative:
#   a lens pill   `lens:a+b`  -> a private unicode marker, swapped after render
#   a link target             -> resolved to an `@label` DESTINATION, which stays
#                                ordinary markdown; a show rule in the projected
#                                library turns it into a real internal jump.
RAW_TYPST = "<!--raw-typst %s-->"


def _raw(typ):
    """Hand emitted Typst through cmarker untouched. NEVER used inside prose."""
    return RAW_TYPST % typ


def prose(text):
    """Convert one PROSE RUN (a paragraph) to a cmarker render call.

    The text handed to cmarker is pure markdown: no raw-typst, no Typst calls.
    """
    spans = [(LIT, text)]

    def pill(m):
        body = m.group(1)
        if body.startswith("lens:"):
            names = [n for n in body[5:].split("+") if n]
            return _raw("#pill(" + ", ".join('"%s"' % n for n in names) + ")")
        return m.group(0)

    # A lens pill is the ONE construct with no markdown spelling, so it is the
    # one place a raw-typst span is unavoidable. It is emitted only when the
    # paragraph actually contains one, so an ordinary paragraph stays clean and
    # its emphasis pairs correctly.
    spans = _split(spans, CODE_RE, pill)
    spans = _split(spans, HTML_ANCHOR_RE,
                   lambda m: _raw("<%s>" % re.sub(r"[^\w-]", "-", m.group(1))))
    body = "".join(t for _k, t in spans)
    return ('#cmarker.render(%s, smart-punctuation: false, scope: SCOPE)'
            % json.dumps(body, ensure_ascii=False))


# ---------------------------------------------------------------------------
# block structure
# ---------------------------------------------------------------------------
ATTR_RE = re.compile(r'(\w[\w-]*)\s*=\s*(?:"([^"]*)"|(\S+))')
OPEN_RE = re.compile(r"^(?P<colons>:{3,})\s*(?P<kind>[a-z-]+)\s*(?P<attrs>\{.*\})?\s*$")
CLOSE_RE = re.compile(r"^:{3,}\s*$")
FENCE_RE = re.compile(r"^(?P<ticks>```+)\s*(?P<lang>[a-zA-Z-]*)\s*$")
HEAD_RE = re.compile(r"^(#{1,6})\s+(.*)$")
LIST_RE = re.compile(r"^(\s*)[-*]\s+(.*)$")
TABLE_SEP_RE = re.compile(r"^\s*\|[\s:|-]+\|\s*$")


def parse_attrs(s):
    return {m.group(1): (m.group(2) if m.group(2) is not None else m.group(3))
            for m in ATTR_RE.finditer(s or "")}


# A block kind and the function that renders it carry THE SAME NAME. The router
# used to derive the call by replacing hyphens with underscores, so `no-goal`
# reached the library as `#no_goal` and one concept had two spellings — the
# authored one and the rendered one — with the rule living in a string
# operation rather than anywhere a reader would look for it.
#
# There is exactly ONE exception, and it is named rather than computed:
# `figure` is a Typst builtin, so shadowing it would break any document using
# the builtin. The authored directive stays `:::figure`; only the function it
# calls differs. Declaring the exception by name is what lets every other kind
# pass through untouched, so a new block kind needs no entry here.
BLOCK_FN_EXCEPTIONS = {"figure": "figure-block"}


def block_fn(kind):
    """The library function that renders an authored block kind."""
    return BLOCK_FN_EXCEPTIONS.get(kind, kind)


def call_args(attrs):
    out = []
    for k, v in attrs.items():
        # An attr reaches the library under the name it was AUTHORED with. The
        # hyphen used to be rewritten to an underscore here, which meant one
        # attr carried two spellings and a reader had to know which side of the
        # router they were on. Typst accepts a hyphen in an argument name, so
        # there is nothing to translate.
        key = k
        if key == "uses":
            # a list-valued attr: `uses="cetz cetz-plot"`
            items = [i for i in re.split(r"[,\s]+", v) if i]
            val = "(" + ", ".join('"%s"' % esc(i) for i in items)
            val += ",)" if len(items) == 1 else ")"
            out.append("%s: %s" % (key, val))
        else:
            out.append('%s: "%s"' % (key, esc(v)))
    return ", ".join(out)


# The authored spine number — `## 00 Foundation`, `### 03.1 The composition
# mechanism`. It is load-bearing IN THE SOURCE: the gate asserts the spine opens
# at 00 and stays in order, and the foundation contract matches a section named
# "00 …". It must NOT reach the rendered heading, because the renderer numbers
# headings itself, and a heading carrying both reads "1.3 01 System at a glance".
# So the number stays authored and stops at the router.
SPINE_NUM_RE = re.compile(r"^\d{2}(?:\.\d+)*\s+(?=\S)")


def strip_spine_number(text):
    """Drop the authored spine number from a heading's DISPLAYED text.

    Applied to the rendered text only, never to the slug: the layer's links
    point at anchors derived from the full authored heading.
    """
    return SPINE_NUM_RE.sub("", text)


def slug(text):
    """A heading's label, matching the markdown slug the layer already links."""
    s = re.sub(r"`[^`]*`", "", text)
    s = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", s)
    s = re.sub(r"[^\w\s-]", "", s).strip().lower()
    return re.sub(r"[\s_]+", "-", s)


def convert(text, lib_path, diagram_convert=None):
    fm = {}
    if text.startswith("---\n"):
        end = text.index("\n---\n", 3)
        for line in text[4:end].split("\n"):
            if ":" in line:
                k, v = line.split(":", 1)
                fm[k.strip()] = v.strip()
        text = text[end + 5:]

    lines = text.split("\n")
    out = ['#import "%s": *' % lib_path, ""]
    if fm:
        out.append("#show: design-doc.with(")
        for k in ("eyebrow", "hero_title", "lede", "footer"):
            if k in fm:
                out.append("  %s: [%s]," % (k, inline(fm[k])))
        out.append(")")
        out.append("")

    i, stack = 0, []
    while i < len(lines):
        line = lines[i]

        m = FENCE_RE.match(line)
        if m:
            # A fence with NO language tag was falling through to the block
            # parser, so its contents were converted as live blocks: a document
            # showing `:::invariant {...}` as an EXAMPLE rendered a real
            # invariant, and a retired attribute inside that example failed the
            # render. A fence is verbatim whichever way it is tagged.
            ticks, lang = m.group("ticks"), m.group("lang") or ""
            j, body = i + 1, []
            while j < len(lines) and not re.match(r"^%s\s*$" % ticks, lines[j]):
                body.append(lines[j])
                j += 1
            payload = "\n".join(body)
            if lang in ("mermaid", "dot") and diagram_convert:
                dot = diagram_convert(lang, payload)
                if dot is not None:
                    out.append("#diagram(%s)"
                               % json.dumps(dot, ensure_ascii=False))
                else:
                    out.append("#diagram-source(%s, %s)"
                               % (json.dumps(lang, ensure_ascii=False),
                                  json.dumps(payload, ensure_ascii=False)))
            else:
                # An untagged fence passes `none`, not "": Typst's raw()
                # treats an empty language as a language, which changes the
                # rendered bytes for every untagged block in a layer.
                out.append("#code-block(%s, %s)"
                           % (json.dumps(lang, ensure_ascii=False) if lang
                              else "none",
                              json.dumps(payload, ensure_ascii=False)))
            i = j + 1
            continue

        m = OPEN_RE.match(line)
        if m:
            kind, colons = m.group("kind"), m.group("colons")
            attrs = parse_attrs((m.group("attrs") or "").strip("{}"))
            args = call_args(attrs)

            # cards and stat-grid are STRUCTURED containers: read to the
            # matching close and hand the renderer real items, so each card is
            # its own card and the tiles form a grid rather than a stack.
            if kind in ("cards", "stat-grid"):
                close = re.compile(r"^%s\s*$" % colons)
                j, body, depth = i + 1, [], 0
                while j < len(lines):
                    if OPEN_RE.match(lines[j]):
                        depth += 1
                    elif CLOSE_RE.match(lines[j]):
                        if depth == 0 and close.match(lines[j]):
                            break
                        depth -= 1
                    body.append(lines[j])
                    j += 1
                if kind == "cards":
                    items, cur = [], None
                    for b in body:
                        h = re.match(r"^###\s+(.*)$", b)
                        if h:
                            cur = {"title": h.group(1), "body": []}
                            items.append(cur)
                        elif cur is not None:
                            cur["body"].append(b)
                    out.append("#cards(%sitems: (" % (args + ", " if args else ""))
                    for it in items:
                        # the TITLE is a fragment (inline); the BODY is a
                        # prose run and takes the CommonMark path.
                        out.append("  (title: [%s], body: [%s]),"
                                   % (inline(it["title"]),
                                      prose("\n".join(it["body"]).strip())))
                    out.append("))")
                else:
                    tiles = []
                    for b in body:
                        t = OPEN_RE.match(b)
                        if t and t.group("kind") == "stat-tile":
                            ta = parse_attrs((t.group("attrs") or "").strip("{}"))
                            tiles.append("  (%s)," % call_args(ta))
                    out.append("#stat-grid(%stiles: (" % (args + ", " if args else ""))
                    out.extend(tiles)
                    out.append("))")
                i = j + 1
                continue

            if kind == "figure":
                close = re.compile(r"^%s\s*$" % colons)
                j, body = i + 1, []
                while j < len(lines) and not close.match(lines[j]):
                    body.append(lines[j])
                    j += 1
                out.append("#figure-block(%s)[" % args)
                out.extend(body)          # verbatim: the body IS renderer markup
                out.append("]")
                i = j + 1
                continue
            out.append("#%s(%s)[" % (block_fn(kind), args))
            stack.append(kind)
            i += 1
            continue

        if CLOSE_RE.match(line) and stack:
            stack.pop()
            out.append("]")
            i += 1
            continue

        h = HEAD_RE.match(line)
        if h:
            # an explicit label, so an intra-document link to this section is
            # checked by the compiler rather than by a script.
            #
            # The SLUG is derived from the full authored text, prefix included,
            # because that is what the layer's existing links point at. Only the
            # DISPLAYED text drops the prefix.
            out.append("=" * len(h.group(1)) + " " + inline(strip_spine_number(h.group(2)))
                       + " <sec-" + slug(h.group(2)) + ">")
            i += 1
            continue

        if line.strip().startswith("|") and i + 1 < len(lines) \
                and TABLE_SEP_RE.match(lines[i + 1]):
            rows = []
            while i < len(lines) and lines[i].strip().startswith("|"):
                if not TABLE_SEP_RE.match(lines[i]):
                    rows.append([c.strip() for c in
                                 lines[i].strip().strip("|").split("|")])
                i += 1
            if rows:
                ncol = max(len(r) for r in rows)
                out.append("#md-table(%d, (" % ncol)
                for r in rows:
                    r = r + [""] * (ncol - len(r))
                    out.append("  " + ", ".join("[%s]" % inline(c) for c in r) + ",")
                out.append("))")
            continue

        lm = LIST_RE.match(line)
        if lm:
            # a list ITEM is a prose run; the bullet stays the router's, so
            # the authored indent still carries nesting depth.
            out.append(lm.group(1) + "- " + prose(lm.group(2)))
            i += 1
            continue

        # PROSE IS CONVERTED A PARAGRAPH AT A TIME, never a line at a time: an
        # inline span may wrap, and a per-line pass can never match one that
        # does. A blank line ends a paragraph and no inline span may cross one,
        # so the paragraph is the correct unit. Newlines inside it are kept, so
        # the rendered line breaking is unchanged.
        # a line that is ONLY an anchor is block-level: emit the label directly
        # so it attaches to what follows. Inside a prose run it would become a
        # label in its own rendered paragraph, attached to nothing.
        only_anchor = HTML_ANCHOR_RE.fullmatch(line.strip())
        if only_anchor:
            out.append("<%s>" % re.sub(r"[^\w-]", "-", only_anchor.group(1)))
            i += 1
            continue

        para = []
        while i < len(lines):
            nxt = lines[i]
            if not nxt.strip():
                break
            if (FENCE_RE.match(nxt) or OPEN_RE.match(nxt) or CLOSE_RE.match(nxt)
                    or HEAD_RE.match(nxt) or LIST_RE.match(nxt)
                    or nxt.lstrip().startswith("|")):
                break
            para.append(nxt)
            i += 1
        if para:
            out.append(prose("\n".join(para)))
        else:
            out.append("")
            i += 1

    return "\n".join(out) + "\n"


def main():
    args = [a for a in sys.argv[1:]]
    lib = "designlib.typ"
    if "--lib" in args:
        k = args.index("--lib")
        lib = args[k + 1]
        del args[k:k + 2]
    if len(args) != 2:
        sys.stderr.write("usage: md-to-typst <design.md> <out.typ> "
                         "[--lib <designlib.typ>]\n")
        return 2
    src, dst = args
    try:
        text = open(src, encoding="utf-8").read()
    except OSError as e:
        sys.stderr.write("md-to-typst: error: cannot read %s: %s\n" % (src, e))
        return 2

    # The diagram converter is migration 0002's transform, imported so the
    # router and the migration cannot diverge. It is REQUIRED: without it every
    # mermaid fence would fall back to rendering its own source as text, which
    # is a silent degradation — the document builds and the drawing is gone.
    mig = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                       "mermaid_to_dot.py")
    if not os.path.exists(mig):
        sys.stderr.write("md-to-typst: error: no diagram converter at %s\n" % mig)
        return 2
    sys.path.insert(0, os.path.dirname(mig))
    import importlib
    _m = importlib.import_module("mermaid_to_dot")

    def diagram_convert(lang, payload):
        if lang == "dot":
            return payload
        conv = _m.convert("```mermaid\n" + payload + "\n```")
        d = re.search(r"```dot\n(.*?)\n```", conv, re.S)
        if d:
            return d.group(1)
        # a shape with no DOT carrier (a sequence diagram) keeps its own source
        # for the carrier that draws it; never silently dropped.
        return None

    open(dst, "w", encoding="utf-8").write(convert(text, lib, diagram_convert))
    return 0


if __name__ == "__main__":
    sys.exit(main())
