#!/usr/bin/env bash
#
# render-project — assemble the renderer's block-contract library directory.
#
# Usage:
#   render-project <path/to/design-schema.json> <out-dir>
#
# Writes <out-dir>/ holding:
#   *.typ                the library, HAND-WRITTEN, copied from lib/
#   design-schema.json   the schema the library reads at compile time
#
# A consumer imports <out-dir>/designlib.typ, exactly as before.
#
# NOTHING HERE IS GENERATED ANY MORE. The library used to be 1730 lines of
# Typst emitted from heredocs inside this file, and after that just one emitted
# file — a translation of the behavior fence's patterns out of the dialect the
# schema declared them in and into the dialect the renderer reads. The schema
# now declares those patterns in the renderer's own dialect, so the fence is
# read like every other vocabulary and there is no file left to write. This
# script COPIES; it does not project.
#
# WHY IT IS STILL A SCRIPT rather than a `cp` at each call site. Several callers
# depend on the assembled directory having exactly one shape — the gate bundle,
# the projection-freshness check, the commit hook, four test suites, and every
# host that runs `nix run <flake>#project` — and an assembly open-coded once per
# caller is one chance per caller for a copy to drift. It also does three things
# a bare `cp` does not: it resolves lib/ from THIS SCRIPT's directory, so a
# caller running out of a read-only store path with any working directory finds
# the library; it refuses rather than leaving a half-directory when the schema
# or the library is missing; and it restores write permission, because a store
# file copies read-only and a later assembly into the same directory could not
# overwrite it.
#
# THE SCHEMA TRAVELS WITH THE LIBRARY. Typst resolves a path in `json()`
# relative to the file containing the call and refuses any path that escapes
# --root, so a library in a read-only bundle cannot reach a consumer's schema by
# a relative path. Copying the schema INTO the assembled directory makes the
# path relative and always resolvable — and it keeps every existing consumer
# working unchanged, because they all copy the whole directory somewhere and
# compile with a --root spanning the copy. The schema is inside the copy.
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "usage: render-project <design-schema.json> <out-dir>" >&2
  exit 2
fi

SCHEMA_PATH="$1"
OUT_DIR="$2"

if [ ! -f "$SCHEMA_PATH" ]; then
  echo "render-project: error: no schema at $SCHEMA_PATH" >&2
  exit 2
fi

# The hand-written library sits beside this script's own directory. Resolving it
# from the script rather than from $PWD is what lets the gate bundle call this
# from a store path with any working directory.
LIB_SRC="$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd || true)"
if [ -z "$LIB_SRC" ] || [ ! -f "$LIB_SRC/designlib.typ" ]; then
  echo "render-project: error: no hand-written library at $(dirname "$0")/../lib" >&2
  exit 2
fi

mkdir -p "$OUT_DIR"
cp "$LIB_SRC"/*.typ "$OUT_DIR/"
cp "$SCHEMA_PATH" "$OUT_DIR/design-schema.json"
chmod u+w "$OUT_DIR"/*.typ "$OUT_DIR/design-schema.json"

# COUNT what was assembled rather than reporting a fixed number. The line is
# read by a human checking that the assembly did something, and a hardcoded
# count would keep claiming the same total after the library gained or lost a
# file.
n=$(find "$OUT_DIR" -maxdepth 1 -name '*.typ' | wc -l | tr -d ' ')
echo "render-project: assembled $OUT_DIR ($n hand-written library file(s) + the schema they read)"
