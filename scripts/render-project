#!/usr/bin/env bash
#
# render-project — assemble the renderer's block-contract library directory.
#
# Usage:
#   render-project <path/to/design-schema.json> <out-dir>
#
# Writes <out-dir>/ holding:
#   *.typ                the library, HAND-WRITTEN, copied from lib/
#   design-schema.json   the schema the library reads at compile time
#   fence.typ            the ONE generated file (see below)
#
# A consumer imports <out-dir>/designlib.typ, exactly as before.
#
# WHAT CHANGED, AND WHY THIS SCRIPT IS SMALL NOW. The library used to be 1730
# lines of Typst emitted from heredocs inside this file. It is now plain Typst
# under lib/, which READS design-schema.json at compile time through `json()`.
# The compile itself is the projection, so a schema edit reaches the library
# with no regeneration step, and a human can read and change the library
# directly instead of reading a Python program that prints it.
#
# THE SCHEMA TRAVELS WITH THE LIBRARY. Typst resolves a path in `json()`
# relative to the file containing the call and refuses any path that escapes
# --root, so a library in a read-only bundle cannot reach a consumer's schema by
# a relative path. Copying the schema INTO the assembled directory makes the
# path relative and always resolvable — and it keeps every existing consumer
# working unchanged, because they all copy the whole directory somewhere and
# compile with a --root spanning the copy. The schema is inside the copy.
#
# WHAT IS STILL GENERATED. `fence.typ`, and nothing else.
#
# The schema declares the behavior fence's id/selector shapes as LUA patterns —
# the authoring side's vocabulary. Typst's regex() is the Rust regex engine, a
# different dialect: no %-escapes, no %f[] frontier assertions. The translation
# below is a table of individually-reviewable claims about what one pattern
# means, not a general Lua-pattern compiler, and it is not something the
# library can compute for itself. So it stays here and is emitted as data.
#
# A pattern the table does not recognize FAILS the assembly rather than being
# guessed at: a wrong regex would silently under-enforce the fence, which is
# worse than refusing to build it.
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "usage: render-project <design-schema.json> <out-dir>" >&2
  exit 2
fi

SCHEMA_PATH="$1"
OUT_DIR="$2"

if [ ! -f "$SCHEMA_PATH" ]; then
  echo "render-project: error: no schema at $SCHEMA_PATH" >&2
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "render-project: error: python3 is required (schema parsing + stable emit)" >&2
  exit 2
fi

# The hand-written library sits beside this script's own directory. Resolving it
# from the script rather than from $PWD is what lets the gate bundle call this
# from a store path with any working directory.
LIB_SRC="$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd || true)"
if [ -z "$LIB_SRC" ] || [ ! -f "$LIB_SRC/designlib.typ" ]; then
  echo "render-project: error: no hand-written library at $(dirname "$0")/../lib" >&2
  exit 2
fi

mkdir -p "$OUT_DIR"
cp "$LIB_SRC"/*.typ "$OUT_DIR/"
cp "$SCHEMA_PATH" "$OUT_DIR/design-schema.json"
chmod u+w "$OUT_DIR"/*.typ "$OUT_DIR/design-schema.json"

python3 - "$SCHEMA_PATH" "$OUT_DIR" <<'PY_END'
import json
import os
import sys

schema_path, out_dir = sys.argv[1], sys.argv[2]

try:
    with open(schema_path, "r", encoding="utf-8") as f:
        schema = json.load(f)
except (OSError, ValueError) as e:
    sys.stderr.write("render-project: error: cannot read schema: %s\n" % e)
    sys.exit(2)

try:
    contract = schema["design_doc"]["behavior_contract"]
    fence = contract["fence"]
    # `levels` carries a prose no_pairing entry alongside the real levels; a
    # level is a key that also has a fence entry. Read exactly as the library
    # reads it, so the two cannot disagree about what a level is.
    levels = [lv for lv in contract["levels"] if lv + "_forbids" in fence]
except (KeyError, TypeError) as e:
    sys.stderr.write(
        "render-project: error: schema missing a required key: %s\n" % e)
    sys.exit(2)

if not levels:
    sys.stderr.write(
        "render-project: error: design_doc.behavior_contract declares no level "
        "with a fence, so the fence table would be empty and the behavior "
        "block's mechanism rule would check nothing\n")
    sys.exit(2)

# THE LUA-TO-RUST PATTERN TRANSLATION. Every entry is one reviewable claim:
#   #[%w_-]+                an id/selector-shaped token: '#' + word chars
#   %.[%a][%w_-]*%-[%w_-]+  a hyphenated CSS class shape: '.foo-bar'
#   %f[%w]id=               Lua's frontier assertion for "id= not glued to a
#                           preceding word char" (so 'id=' but not 'valid=') —
#                           the Rust engine has no frontier/lookbehind, but a
#                           leading \b checks the same transition, because '='
#                           is not itself a word char: '\bid=' matches exactly
#                           where 'i' begins a new word
#   data%-testid            a literal hyphen, '%-' being Lua's escape for a
#                           pattern-magic '-'; equivalent to the literal text
_LUA_PATTERN_TRANSLATION = {
    "#[%w_-]+": r"#[A-Za-z0-9_-]+",
    "%.[%a][%w_-]*%-[%w_-]+": r"\.[A-Za-z][A-Za-z0-9_-]*-[A-Za-z0-9_-]+",
    "%f[%w]id=": r"\bid=",
    "data%-testid": r"data-testid",
}


def q(s):
    return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"') + '"'


def tuple_of(values):
    vs = list(values)
    if len(vs) == 1:
        return "(" + q(vs[0]) + ",)"
    return "(" + ", ".join(q(v) for v in vs) + ")"


L = [
    "// GENERATED by scripts/render-project from design-schema.json.",
    "// Never hand-edit: re-run render-project to refresh it.",
    "//",
    "// THE ONE GENERATED FILE in this library. The schema declares the fence's",
    "// id/selector shapes as LUA patterns; Typst's regex() is the Rust regex",
    "// engine, a different dialect. The translation is a table of individually",
    "// reviewable claims about what one pattern means, which is why it is not",
    "// something the library computes for itself.",
    "//",
    "// Declared enforcement=partial: it catches the shapes named here (an id or",
    '// selector, a bare term like "controller") and misses a mechanism named in',
    '// ordinary words ("the blue button"), exactly as the schema\'s own',
    "// honest_limit states.",
    "#let BEHAVIOR-FENCE = (",
]
for lv in levels:
    half = fence[lv + "_forbids"]
    translated = []
    for p in half["patterns"]:
        if p not in _LUA_PATTERN_TRANSLATION:
            sys.stderr.write(
                "render-project: error: no Typst-regex translation for behavior "
                "fence Lua pattern %r (level %s) — add it to "
                "_LUA_PATTERN_TRANSLATION in scripts/render-project\n" % (p, lv))
            sys.exit(2)
        translated.append(_LUA_PATTERN_TRANSLATION[p])
    L.append("  " + q(lv) + ": (terms: " + tuple_of(half["terms"])
             + ", patterns: " + tuple_of(translated) + "),")
L.append(")")

target = os.path.join(out_dir, "fence.typ")
with open(target, "w", encoding="utf-8") as f:
    f.write("\n".join(L) + "\n")

sys.stdout.write(
    "render-project: assembled %s (hand-written library + schema + a generated "
    "fence over %d level(s))\n" % (out_dir, len(levels)))
PY_END
