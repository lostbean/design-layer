#!/usr/bin/env python3
"""token-coverage — the semantic look is total over the tokens it references.

Every semantic token a projected block renderer REFERENCES must be DEFINED in
the projected token table. A reference with no definition renders as unstyled
fallback, which is a silent failure: the document builds, the gate passes, and
one block kind quietly loses its accent.

HOW THE LIBRARY IS INSPECTED, AND WHY IT CHANGED. This check used to parse the
library's SOURCE TEXT with regexes, which was viable while the library was one
generated file whose tables were emitted as literal `"key": rgb(...)` lines.
The library is hand-written now, spread across files by concern, and its tables
are BUILT — `_assert-total` folds a hue table against the schema-derived key
list it must cover. There is no literal table left for a regex to read.

So the library is asked, at compile time, what it holds. `typst query` compiles
it and reports each table's keys and each vocabulary's members as data. That is
the stronger question anyway: it reports the values the renderer will actually
use, where the regex reported a spelling that happened to appear in a file.

SCOPE, declared honestly. This proves every referenced token IS DEFINED. It
does not prove the colour is right, nor that the distinction reads. A token
defined as the wrong hue passes. Enforcement is `mechanism` for the property it
states — a reference with no definition at all — not for the look.

Usage: token-coverage [layer-root]     (default: docs/design)

Exit: 0 every referenced token is defined
      1 at least one reference has no definition (one report line each)
      2 usage or IO error — no projected library, unreadable file
"""

import json
import os
import re
import subprocess
import sys
import tempfile

# a lookup a block renderer performs: `TABLE.at("key")` or `TABLE.key`. This
# half stays TEXTUAL, deliberately: it asks whether any line in the library
# names a token, and a lookup that is never reached at runtime leaves no trace
# for a runtime instrument to find — which is precisely the reference being
# hunted. The library's own files are the right substrate for that question.
LOOKUP_RE = re.compile(r"\b([A-Z][A-Z_-]*)\.at\(\s*([a-z_]+|\"[^\"]+\")")

# THE TABLES ARE DISCOVERED, NEVER LISTED. A hand-written list of which tables
# to check is a second declaration of what the library defines, and the two
# drift the moment a table is added — silently, because a check that examines
# fewer tables still prints OK. That is the exact failure this repo keeps
# finding, so the list does not exist: the compiled library is enumerated and
# every table it defines is checked.
TABLE_SUFFIX = "-COLOR"

# HOW A TABLE FINDS ITS VOCABULARY: by the library's own naming convention,
# `<THING>-COLOR` is covered by the vocabulary naming the same thing in the
# plural. The regular rule is to drop -COLOR and add S (LENS-COLOR -> LENSES,
# ENTITY-KIND-COLOR -> ENTITY-KINDS). Two vocabularies are named for what their
# members ARE rather than for the table, so they are stated here — a mapping of
# three entries, each of which fails loudly if the name it points at stops
# existing, rather than a list that decides WHICH tables get checked at all.
IRREGULAR = {
    "COVERAGE-COLOR": "COVERAGE-STATUSES",
    "PENDING-COLOR": "PENDING-KINDS",
}

# THE ONE TABLE WITH NO CLOSED VOCABULARY, declared and justified rather than
# skipped. KIND-COLOR is keyed by BLOCK KIND, which is an open set: every reader
# looks it up as `.at(kind, default: luma(120))`, so a kind with no entry falls
# back to a neutral tone instead of rendering wrong. There is no vocabulary it
# must be total against. Its keys are still checked by the LOOKUP half below,
# which is the half that can say anything about an open table.
#
# THE EXEMPTION IS BY NAME AND ONE NAME ONLY. A table added later is NOT exempt;
# it has no vocabulary partner, and the pairing below makes that an error.
OPEN_TABLES = {"KIND-COLOR"}


def _vocabulary_for(table):
    """The vocabulary name a table must be total against, by convention.

    The plural is the English one the library already writes: LENS -> LENSES,
    ENTITY-KIND -> ENTITY-KINDS. A name ending in S or CH takes ES, and one
    ending in a consonant plus Y takes IES.
    """
    if table in IRREGULAR:
        return IRREGULAR[table]
    stem = table[: -len(TABLE_SUFFIX)]
    if stem.endswith("Y") and len(stem) > 1 and stem[-2] not in "AEIOU":
        return stem[:-1] + "IES"
    return stem + ("ES" if stem.endswith(("S", "CH")) else "S")


def probe(lib_dir):
    """Ask the compiled library what token tables and vocabularies it holds.

    TWO PASSES, because the second question depends on the first. Pass one
    enumerates the module with `dictionary()` and learns which names exist and
    what type each one is — the same instrument widget-coverage uses, and for
    the same reason: it reports what the library actually provides rather than
    what some list says it should. Pass two asks each discovered table for its
    keys and each discovered vocabulary for its members.

    Returns (tables, lists, defined) where `defined` is every table name the
    library holds — including one the pairing rejects — so the caller can
    report a table that went unchecked rather than quietly checking fewer.
    """
    lib_abs = os.path.abspath(lib_dir)

    def _query(body, tmp):
        root = os.path.commonpath([os.path.abspath(tmp), lib_abs])
        entry = os.path.join("/", os.path.relpath(
            os.path.join(lib_abs, "designlib.typ"), root))
        probe_typ = os.path.join(tmp, "probe.typ")
        with open(probe_typ, "w", encoding="utf-8") as f:
            f.write(body % {"entry": entry} + "\n")
        proc = subprocess.run(
            [os.environ.get("TYPST", "typst"), "query", "--root", root,
             probe_typ, "<tokens>", "--field", "value"],
            capture_output=True, text=True,
            env=dict(os.environ, SOURCE_DATE_EPOCH="0"))
        if proc.returncode != 0:
            raise RuntimeError("the library could not be compiled:\n%s"
                               % proc.stderr.strip())
        try:
            rows = json.loads(proc.stdout or "[]")
        except ValueError as e:
            raise RuntimeError("the probe's answer could not be read: %s" % e)
        if rows and isinstance(rows[0], list):
            rows = rows[0]
        if not rows:
            raise RuntimeError("the probe returned no answer at all")
        return rows

    # THE PROBE IS WRITTEN OUTSIDE THE LIBRARY, always. For a host the library
    # is a read-only Nix store path, so a probe written beside it fails with a
    # permission error — and this check must not be the thing that decides
    # whether the gate can run. The probe lives in a temp directory and imports
    # the library by absolute path, with --root spanning both.
    with tempfile.TemporaryDirectory(prefix="token-coverage.") as tmp:
        surface = _query(
            '#import "%(entry)s" as lib\n'
            "#metadata(dictionary(lib).pairs()"
            ".map(p => (name: p.at(0), kind: str(type(p.at(1))))))<tokens>",
            tmp)

    members = {r["name"]: r["kind"] for r in surface
               if isinstance(r, dict) and "name" in r}
    # A table is a DICTIONARY whose name carries the convention's suffix. The
    # type test is what stops a string or a function that happens to end in
    # -COLOR from being called a table and checked as one.
    defined = sorted(n for n, k in members.items()
                     if n.endswith(TABLE_SUFFIX) and k == "dictionary")
    if not defined:
        raise RuntimeError(
            "the compiled library defines no %s table at all — a token check "
            "over no table passes vacuously, so this is refused rather than "
            "reported clean" % TABLE_SUFFIX)

    # PAIR EACH DISCOVERED TABLE, and refuse one that cannot be paired. This is
    # what keeps the hole closed: a table added to the library with no matching
    # vocabulary stops the check by name instead of being passed over.
    pairs, unpairable = {}, []
    for t in defined:
        if t in OPEN_TABLES:
            continue
        v = _vocabulary_for(t)
        if members.get(v) != "array":
            unpairable.append(
                "%s has no vocabulary to be total against — expected an array "
                "named %s, which the library does not define. Name the "
                "vocabulary by the convention, or declare the table open in "
                "OPEN_TABLES with the reason." % (t, v))
            continue
        pairs[t] = v
    if unpairable:
        raise RuntimeError("\n  ".join(
            ["a token table could not be paired with its vocabulary:"]
            + unpairable))

    # The open tables are queried too. They have no vocabulary to be total
    # against, but their KEYS are real tokens the summary must count and the
    # lookup half must be able to resolve against.
    open_here = sorted(OPEN_TABLES & set(defined))
    wanted = sorted(set(pairs) | set(pairs.values()) | set(open_here))
    table_names = set(pairs) | set(open_here)
    fields = []
    for n in wanted:
        # a table answers with its keys, a vocabulary with its members
        expr = ("%s.keys()" % n) if n in table_names else ("array(%s)" % n)
        fields.append('"%s": %s' % (n, expr))
    with tempfile.TemporaryDirectory(prefix="token-coverage.") as tmp:
        rows = _query(
            '#import "%%(entry)s": %s\n#metadata((%s))<tokens>'
            % (", ".join(wanted), ", ".join(fields)),
            tmp)

    row = rows[0]
    tables = {t: list(row.get(t, [])) for t in pairs}
    lists = {v: list(row.get(v, [])) for v in set(pairs.values())}
    open_keys = {t: list(row.get(t, [])) for t in open_here}
    return tables, lists, pairs, defined, open_keys


def main():
    root = sys.argv[1] if len(sys.argv) > 1 else "docs/design"
    # $DESIGN_LIB_DIR wins so the projected library can live outside the layer
    # — in a read-only bundle, say — with the layer-root copy as the fallback.
    lib_dir = os.environ.get("DESIGN_LIB_DIR") or os.path.join(root, ".render")
    lib = os.path.join(lib_dir, "designlib.typ")
    if not os.path.exists(lib):
        sys.stderr.write("token-coverage: error: no projected library at %s "
                         "(run render-project, or set DESIGN_LIB_DIR)\n" % lib)
        return 2

    try:
        tables, lists, pairs, defined, open_keys = probe(lib_dir)
    except RuntimeError as e:
        sys.stderr.write("token-coverage: error: %s\n" % e)
        return 2

    # EVERY TABLE THE LIBRARY DEFINES IS ACCOUNTED FOR. This is the assertion
    # that makes a silent loss of coverage impossible: the tables examined, plus
    # the ones explicitly declared open, must equal the tables the library
    # holds. A tenth table appearing with nobody updating this check fails HERE,
    # naming it, rather than leaving the check quietly covering nine.
    accounted = set(pairs) | (OPEN_TABLES & set(defined))
    unaccounted = sorted(set(defined) - accounted)
    if unaccounted:
        sys.stderr.write(
            "token-coverage: error: the library defines %d token table(s) but "
            "this check examines %d — unaccounted: %s. A table nobody checks "
            "is coverage silently lost, so this is refused rather than "
            "reported clean.\n"
            % (len(defined), len(pairs), ", ".join(unaccounted)))
        return 2

    # THE ZERO CASE IS THE DANGEROUS ONE: every membership test below passes
    # vacuously against an empty vocabulary, so the check would go green having
    # verified nothing. Refuse before the checks rather than after.
    empty = [n for n, v in list(tables.items()) + list(lists.items()) if not v]
    if empty:
        sys.stderr.write(
            "token-coverage: error: the compiled library reports no member for "
            "%s — a coverage check over an empty set passes vacuously, so this "
            "is refused rather than reported clean\n" % ", ".join(sorted(empty)))
        return 2

    # The lookup half reads the library's own files, which is where a lookup
    # that is never reached at runtime is still visible.
    src = ""
    for name in sorted(os.listdir(lib_dir)):
        if name.endswith(".typ"):
            try:
                src += open(os.path.join(lib_dir, name), encoding="utf-8").read()
                src += "\n"
            except OSError as e:
                sys.stderr.write("token-coverage: error: cannot read %s: %s\n"
                                 % (name, e))
                return 2

    violations = []

    # 1. every member of a declared vocabulary has a token in its paired table
    for table, vocab in sorted(pairs.items()):
        for member in lists[vocab]:
            if member not in tables[table]:
                violations.append(
                    "%s member %r has no token in %s — it would render as "
                    "unstyled fallback" % (vocab, member, table))

    # 2. every literal lookup a renderer performs names a defined key.
    # Both kinds of table answer here: a totality-checked one and an open one.
    known = dict(tables)
    known.update(open_keys)
    for m in LOOKUP_RE.finditer(src):
        table, key = m.group(1), m.group(2)
        if not key.startswith('"'):
            continue                      # a variable lookup: covered by (1)
        key = key.strip('"')
        if table in known and key not in known[table]:
            violations.append("%s.at(%r) names no token the compiled library "
                              "defines — it would render as unstyled fallback"
                              % (table, key))

    for v in violations:
        sys.stderr.write("token-coverage: violation: %s\n" % v)
    if violations:
        return 1
    # THE COUNT REPORTS EVERY TABLE THE LIBRARY DEFINES, not only the ones the
    # totality half could bind. A summary that counted fewer tables than exist
    # is how a loss of coverage hides in plain sight, so the open tables are
    # counted here and their treatment is named rather than omitted.
    open_here = sorted(OPEN_TABLES & set(defined))
    open_tokens = sum(len(open_keys.get(t, ())) for t in open_here)
    total = sum(len(v) for v in tables.values()) + open_tokens
    sys.stdout.write(
        "token-coverage: OK — %d token(s) across %d table(s); %d table(s) "
        "checked total against their vocabulary%s; every referenced token is "
        "defined\n"
        % (total, len(defined), len(tables),
           (", %d open table(s) (%s) checked by lookup only"
            % (len(open_here), ", ".join(open_here))) if open_here else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
