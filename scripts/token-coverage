#!/usr/bin/env python3
"""token-coverage — the semantic look is total over the tokens it references.

Every semantic token a projected block renderer REFERENCES must be DEFINED in
the projected token table. A reference with no definition renders as unstyled
fallback, which is a silent failure: the document builds, the gate passes, and
one block kind quietly loses its accent.

This is the same property overlay-coverage held under the retired renderer,
with its substrate changed. There it compared emitted CSS classes against the
rules of a stylesheet overlay; here it compares token lookups against the token
table. Both sides are generated by the projector from one schema, so the check
compares two projections of the same source and needs no hand-maintained list.

SCOPE, declared honestly. This proves every referenced token IS DEFINED. It
does not prove the colour is right, nor that the distinction reads. A token
defined as the wrong hue passes. Enforcement is `mechanism` for the property it
states — a reference with no definition at all — not for the look.

Usage: token-coverage [layer-root]     (default: docs/design)

Exit: 0 every referenced token is defined
      1 at least one reference has no definition (one report line each)
      2 usage or IO error — no projected library, unreadable file
"""

import os
import re
import sys

# a token table the projector emits: `#let NAME = ( "key": ..., )`
TABLE_RE = re.compile(r"^#let\s+([A-Z][A-Z_]*)\s*=\s*\($", re.M)
KEY_RE = re.compile(r'^\s*"([^"]+)"\s*:', re.M)
# a lookup a block renderer performs: `TABLE.at("key")` or `TABLE.key`
LOOKUP_RE = re.compile(r"\b([A-Z][A-Z_]*)\.at\(\s*([a-z_]+|\"[^\"]+\")")
# a member list the library also carries: `#let LENSES = ("a", "b")`
LIST_RE = re.compile(r"^#let\s+([A-Z][A-Z_]*)\s*=\s*\(([^)]*)\)\s*$", re.M)


def parse_tables(src):
    """Every token table the library defines, as {NAME: {keys}}."""
    tables, lines = {}, src.split("\n")
    for m in TABLE_RE.finditer(src):
        name = m.group(1)
        start = src[:m.start()].count("\n") + 1
        keys, depth = set(), 1
        for line in lines[start:]:
            depth += line.count("(") - line.count(")")
            k = KEY_RE.match(line)
            if k:
                keys.add(k.group(1))
            if depth <= 0:
                break
        tables[name] = keys
    return tables


def parse_lists(src):
    """Every declared member list, as {NAME: [members]}."""
    out = {}
    for m in LIST_RE.finditer(src):
        members = re.findall(r'"([^"]*)"', m.group(2))
        if members:
            out[m.group(1)] = members
    return out


# a token table and the vocabulary it must cover, by naming convention: the
# projector emits LENS_COLOR beside LENSES, TINT_COLOR beside TINTS.
PAIRS = {
    "LENS_COLOR": "LENSES",
    "TINT_COLOR": "TINTS",
    "ENFORCEMENT_COLOR": "ENFORCEMENTS",
}


def main():
    root = sys.argv[1] if len(sys.argv) > 1 else "docs/design"
    # $DESIGN_LIB_DIR wins so the projected library can live outside the layer
    # — in a read-only bundle, say — with the layer-root copy as the fallback.
    lib_dir = os.environ.get("DESIGN_LIB_DIR") or os.path.join(root, ".render")
    lib = os.path.join(lib_dir, "designlib.typ")
    if not os.path.exists(lib):
        sys.stderr.write("token-coverage: error: no projected library at %s "
                         "(run render-project, or set DESIGN_LIB_DIR)\n" % lib)
        return 2
    try:
        src = open(lib, encoding="utf-8").read()
    except OSError as e:
        sys.stderr.write("token-coverage: error: cannot read %s: %s\n" % (lib, e))
        return 2

    tables = parse_tables(src)
    lists = parse_lists(src)
    violations = []

    # 1. every member of a declared vocabulary has a token in its paired table
    for table, vocab in PAIRS.items():
        if table not in tables:
            violations.append("the library defines no %s token table" % table)
            continue
        if vocab not in lists:
            violations.append("the library declares no %s vocabulary" % vocab)
            continue
        for member in lists[vocab]:
            if member not in tables[table]:
                violations.append(
                    "%s member %r has no token in %s — it would render as "
                    "unstyled fallback" % (vocab, member, table))

    # 2. every literal lookup a renderer performs names a defined key
    for m in LOOKUP_RE.finditer(src):
        table, key = m.group(1), m.group(2)
        if not key.startswith('"'):
            continue                      # a variable lookup: covered by (1)
        key = key.strip('"')
        if table in tables and key not in tables[table]:
            line = src[:m.start()].count("\n") + 1
            violations.append("%s:%d: %s.at(%r) names no defined token"
                              % (lib, line, table, key))

    for v in violations:
        sys.stderr.write("token-coverage: violation: %s\n" % v)
    if violations:
        return 1
    total = sum(len(v) for v in tables.values())
    sys.stdout.write("token-coverage: OK — %d token(s) across %d table(s), "
                     "every referenced token is defined\n"
                     % (total, len(tables)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
